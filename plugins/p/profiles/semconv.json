{
  "schema_version": 1,
  "profile_id": "otel-openinference-v1",
  "references": [
    "https://opentelemetry.io/docs/specs/semconv/registry/attributes/gen-ai/",
    "https://github.com/Arize-ai/openinference/blob/main/spec/semantic_conventions.md"
  ],
  "field_mappings": {
    "span_kind": "openinference.span.kind",
    "input_tokens": "gen_ai.usage.input_tokens",
    "output_tokens": "gen_ai.usage.output_tokens",
    "tool_kind": "gen_ai.tool.name"
  },
  "value_mappings": {
    "span_kind": {
      "trace": "CHAIN",
      "prompt": "PROMPT",
      "llm": "LLM",
      "tool": "TOOL",
      "agent": "AGENT",
      "handoff": "AGENT",
      "guardrail": "GUARDRAIL",
      "evaluator": "EVALUATOR"
    }
  },
  "kind_attributes": {
    "llm": {"gen_ai.operation.name": "chat"},
    "tool": {"gen_ai.operation.name": "execute_tool"},
    "handoff": {"gen_ai.operation.name": "invoke_agent"},
    "agent": {"gen_ai.operation.name": "invoke_agent"}
  }
}
