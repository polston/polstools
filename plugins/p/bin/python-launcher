#!/usr/bin/env sh
# Find a usable Python 3 without assuming one harness's PATH. The optional
# override is a single executable path, not a shell fragment.
set -eu

# Shell fast-path for hook gate evaluations when formatting is inactive
if [ "${2:-}" = "gate" ]; then
  case "${1:-}" in
    *format-ctl)
      if [ -z "${RETRO_HOME:-}" ] && [ "${P_FORMAT_DEFAULT:-}" != "on" ]; then
        cfg="${P_FORMAT_CONFIG_FILE:-}"
        if [ -z "$cfg" ]; then
          if [ -n "${LOCALAPPDATA:-}" ]; then
            cfg="$LOCALAPPDATA/polstools/format.json"
          else
            cfg="${XDG_CONFIG_HOME:-$HOME/.config}/polstools/format.json"
          fi
        fi
        if [ ! -f "$cfg" ] || ! grep -q '"on"' "$cfg" 2>/dev/null; then
          fdir="${P_FORMAT_STATE_DIR:-}"
          if [ -z "$fdir" ]; then
            if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
              fdir="$XDG_RUNTIME_DIR/p-format-toggle"
            else
              uid=$(id -u 2>/dev/null || true)
              [ -z "$uid" ] && uid="${USERNAME:-default}"
              fdir="${TMPDIR:-${TEMP:-/tmp}}/p-format-toggle-$uid"
            fi
          fi
          sid="${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-${ANTIGRAVITY_SESSION_ID:-${ANTIGRAVITY_CONVERSATION_ID:-${AGY_SESSION_ID:-${AGY_CONVERSATION_ID:-}}}}}}}"
          if [ -n "$sid" ]; then
            if [ ! -f "$fdir/$sid.on" ]; then
              exit 0
            fi
          elif [ ! -d "$fdir" ]; then
            exit 0
          elif ! ls "$fdir"/*.on >/dev/null 2>&1; then
            exit 0
          fi
        fi
      fi
      ;;
  esac
fi

shell_path() {
  value=$1
  case "$value" in
    [A-Za-z]:\\* | [A-Za-z]:/*)
      if command -v cygpath >/dev/null 2>&1; then
        cygpath -u "$value"
        return
      fi
      ;;
  esac
  printf '%s\n' "$value"
}

# The supported floor. Every candidate is probed before it is used, so a
# Windows Store alias, a Python 2 "python", or an interpreter older than the
# floor is skipped instead of failing the command.
usable() {
  # A positive answer is required: a stub that exits 0 for any arguments
  # must not pass.
  [ "$("$@" -S -E -c 'import sys; print("python-ok" if sys.version_info >= (3, 9) else "")' \
    2>/dev/null)" = python-ok ]
}

python_override=$(shell_path "${POLSTOOLS_PYTHON:-}")
if [ -n "$python_override" ] && [ -x "$python_override" ]; then
  if usable "$python_override"; then
    exec "$python_override" "$@"
  fi
  echo "python-launcher: POLSTOOLS_PYTHON is not Python 3.9 or newer; searching PATH" >&2
fi

# Every PATH entry, not only the first match: a stub that shadows a real
# interpreter must not hide it.
set -f
old_ifs=$IFS
IFS=:
search_path=$PATH
for name in python3 python; do
  for dir in $search_path; do
    for candidate in "${dir:-.}/$name" "${dir:-.}/$name.exe"; do
      if [ -f "$candidate" ] && [ -x "$candidate" ] && usable "$candidate"; then
        IFS=$old_ifs
        set +f
        exec "$candidate" "$@"
      fi
    done
  done
done
IFS=$old_ifs
set +f

if command -v py >/dev/null 2>&1 && usable py -3; then
  exec py -3 "$@"
fi

# uv-managed Windows installations are intentionally not required to be on
# PATH. Normalize native environment paths before globbing from POSIX sh.
app_data=$(shell_path "${APPDATA:-}")
local_app_data=$(shell_path "${LOCALAPPDATA:-}")
if [ -n "$app_data" ]; then
  for candidate in "$app_data"/uv/python/*/python.exe; do
    if [ -x "$candidate" ] && usable "$candidate"; then
      exec "$candidate" "$@"
    fi
  done
fi
if [ -n "$local_app_data" ]; then
  for candidate in "$local_app_data"/Programs/Python/Python*/python.exe; do
    if [ -x "$candidate" ] && usable "$candidate"; then
      exec "$candidate" "$@"
    fi
  done
fi

if command -v uv >/dev/null 2>&1; then
  cache_base=$(shell_path "${TMPDIR:-${TEMP:-/tmp}}")
  UV_CACHE_DIR=${UV_CACHE_DIR:-${POLSTOOLS_UV_CACHE:-$cache_base/polstools-uv-cache}}
  export UV_CACHE_DIR
  exec uv run --no-project python "$@"
fi

echo "python-launcher: Python 3 not found" >&2
exit 2
