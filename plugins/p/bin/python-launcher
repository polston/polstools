#!/usr/bin/env sh
# Find a usable Python 3 without assuming one harness's PATH. The optional
# override is a single executable path, not a shell fragment.
set -eu

if [ -n "${POLSTOOLS_PYTHON:-}" ] && [ -x "$POLSTOOLS_PYTHON" ]; then
  exec "$POLSTOOLS_PYTHON" "$@"
fi

for name in python3 python; do
  if command -v "$name" >/dev/null 2>&1; then
    exec "$name" "$@"
  fi
done

if command -v py >/dev/null 2>&1; then
  exec py -3 "$@"
fi

# uv-managed Windows installations are intentionally not required to be on
# PATH. The wildcard stays below the platform-owned uv directory.
for candidate in "${APPDATA:-}/uv/python"/*/python.exe \
                 "${LOCALAPPDATA:-}/Programs/Python"/Python*/python.exe; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

if command -v uv >/dev/null 2>&1; then
  exec uv run --no-project python "$@"
fi

echo "python-launcher: Python 3 not found" >&2
exit 2
