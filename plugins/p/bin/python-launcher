#!/usr/bin/env sh
# Find a usable Python 3 without assuming one harness's PATH. The optional
# override is a single executable path, not a shell fragment.
set -eu

shell_path() {
  value=$1
  case "$value" in
    [A-Za-z]:\\* | [A-Za-z]:/*)
      if command -v cygpath >/dev/null 2>&1; then
        cygpath -u "$value"
        return
      fi
      ;;
  esac
  printf '%s\n' "$value"
}

# The supported floor. Every candidate is probed before it is used, so a
# Windows Store alias, a Python 2 "python", or an interpreter older than the
# floor is skipped instead of failing the command.
usable() {
  # A positive answer is required: a stub that exits 0 for any arguments
  # must not pass.
  [ "$("$@" -S -E -c 'import sys; print("python-ok" if sys.version_info >= (3, 12) else "")' \
    2>/dev/null)" = python-ok ]
}

# launch N WORD... ARG...: the first N words are the interpreter command.
# N=0 delegates interpreter selection to uv.
launch() {
  n=$1
  shift
  case $n in
    1) usable "$1" || return 0 ;;
    2) usable "$1" "$2" || return 0 ;;
  esac
  exec "$@"
}

python_override=$(shell_path "${POLSTOOLS_PYTHON:-}")
if [ -n "$python_override" ]; then
  if [ -x "$python_override" ]; then
    launch 1 "$python_override" "$@"
    echo "python-launcher: POLSTOOLS_PYTHON is not Python 3.12 or newer; searching PATH" >&2
  else
    echo "python-launcher: POLSTOOLS_PYTHON is not an executable file; searching PATH" >&2
  fi
fi

# Every PATH entry, not only the first match: a stub that shadows a real
# interpreter must not hide it.
old_ifs=$IFS
for name in python3 python; do
  set -f
  IFS=:
  for dir in $PATH; do
    IFS=$old_ifs
    set +f
    for candidate in "${dir:-.}/$name" "${dir:-.}/$name.exe"; do
      if [ -f "$candidate" ] && [ -x "$candidate" ]; then
        launch 1 "$candidate" "$@"
      fi
    done
  done
  IFS=$old_ifs
  set +f
done

if command -v py >/dev/null 2>&1; then
  launch 2 py -3 "$@"
fi

# uv-managed Windows installations are intentionally not required to be on
# PATH. Normalize native environment paths before globbing from POSIX sh.
app_data=$(shell_path "${APPDATA:-}")
local_app_data=$(shell_path "${LOCALAPPDATA:-}")
if [ -n "$app_data" ]; then
  for candidate in "$app_data"/uv/python/*/python.exe; do
    if [ -x "$candidate" ]; then
      launch 1 "$candidate" "$@"
    fi
  done
fi
if [ -n "$local_app_data" ]; then
  for candidate in "$local_app_data"/Programs/Python/Python*/python.exe; do
    if [ -x "$candidate" ]; then
      launch 1 "$candidate" "$@"
    fi
  done
fi

if command -v uv >/dev/null 2>&1; then
  # uv keeps its own per-user cache unless one is named. A cache under the
  # temp directory is used only when it is a real directory this user owns
  # (created here with a private mode); a name someone else planted in a
  # shared temp directory is never used.
  if [ -z "${UV_CACHE_DIR:-}" ]; then
    UV_CACHE_DIR=${POLSTOOLS_UV_CACHE:-}
    if [ -z "$UV_CACHE_DIR" ] && [ -n "${TMPDIR:-}" ]; then
      cache_dir=$(shell_path "$TMPDIR")/polstools-uv-cache
      mkdir -m 700 "$cache_dir" 2>/dev/null || :
      if [ -d "$cache_dir" ] && [ ! -L "$cache_dir" ] && [ -O "$cache_dir" ]; then
        UV_CACHE_DIR=$cache_dir
      fi
    fi
  fi
  if [ -n "$UV_CACHE_DIR" ]; then
    export UV_CACHE_DIR
  else
    unset UV_CACHE_DIR
  fi
  launch 0 uv run --no-project python "$@"
fi

echo "python-launcher: Python 3 not found" >&2
exit 2
