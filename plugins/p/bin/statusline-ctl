#!/usr/bin/env python3
"""Align Claude Code and Codex CLI status information.

Subcommands:
  sync     check, apply safe drift, and verify the resulting alignment
  check    report whether supported Claude and Codex settings align
  preview  print representative Claude and Codex status lines
  apply    preserve ccstatusline or install fallback, then align Codex
  profile-sync  install or refresh only the owned Claude profile indicator
  restore  restore settings changed by apply when untouched afterwards

Exit: 0 ran clean and flagged nothing, 1 ran clean and flagged drift, 2 could
not run. Rollback metadata contains only settings managed by apply.
"""

from __future__ import annotations

import argparse
import copy
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

try:
    import tomllib
except ModuleNotFoundError:  # Python 3.9 and 3.10
    tomllib = None


for _stream in (sys.stdin, sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8")


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
PROFILE_PATH = PLUGIN_ROOT / "profiles" / "aligned-v1.json"
RENDERER_SOURCE = PLUGIN_ROOT / "renderer" / "claude-statusline.ps1"
PROFILE_LABEL_SOURCE = PLUGIN_ROOT / "renderer" / "skill-profile-label.py"
ACTIVATION_LIB_SOURCE = PLUGIN_ROOT / "lib" / "skill_activation.py"
ACTIVATION_PROFILE_SOURCE = PLUGIN_ROOT / "profiles" / "skill-activation-v1.json"
ROLLBACK_NAME = "rollback-v1.json"
PROFILE_OWNER = "skill-activation-v1"
PROFILE_WIDGET_ID = "p-skill-profile"


def load_profile():
    with PROFILE_PATH.open(encoding="utf-8") as handle:
        profile = json.load(handle)
    if profile.get("version") != 1:
        raise ValueError("unsupported profile version")
    items = profile.get("codexStatusLine")
    if not isinstance(items, list) or not all(isinstance(x, str) and x for x in items):
        raise ValueError("profile codexStatusLine must be a string array")
    return profile


PROFILE = load_profile()
CODEX_STATUS_LINE = tuple(PROFILE["codexStatusLine"])


def percent_left(used):
    if used is None:
        return None
    return 100 - max(0, min(100, float(used)))


def _display_percent(value):
    value = float(value)
    return str(int(round(value))) if value == round(value) else ("%.1f" % value).rstrip("0").rstrip(".")


def _bar(left, color):
    slots = 10
    filled = int(round(max(0, min(100, float(left))) / 100 * slots))
    body = "█" * filled + "░" * (slots - filled)
    if not color:
        return body
    used = 100 - float(left)
    tone = "\x1b[31m" if used >= 80 else "\x1b[33m" if used >= 60 else "\x1b[32m"
    return tone + body + "\x1b[0m"


def render_claude(data, *, color=True, profile_label="p:h"):
    """Pure renderer used by preview/tests; the installed PowerShell matches it."""
    esc = "\x1b["
    reset = esc + "0m" if color else ""
    dim = esc + "2m" if color else ""
    cyan = esc + "2;36m" if color else ""
    yellow = esc + "2;33m" if color else ""
    magenta = esc + "35m" if color else ""

    model = ((data.get("model") or {}).get("display_name") or "").strip()
    effort = ((data.get("effort") or {}).get("level") or "").strip()
    workspace = data.get("workspace") or {}
    cwd = (workspace.get("current_dir") or data.get("cwd") or "").strip()
    branch = (workspace.get("git_branch") or "").strip()
    remaining = (data.get("context_window") or {}).get("remaining_percentage")

    parts = []
    if model:
        parts.append(cyan + model + reset)
    if effort:
        parts.append(dim + "eff" + reset + " " + magenta + effort + reset)
    if cwd:
        parts.append(dim + cwd + reset)
    if branch:
        parts.append(yellow + branch + reset)
    if remaining is not None:
        left = max(0, min(100, float(remaining)))
        parts.append(_bar(left, color) + " " + _display_percent(left) + "% left")
    parts.append(dim + profile_label + reset)

    limits = []
    rate_limits = data.get("rate_limits") or {}
    for label, key in (("5h", "five_hour"), ("wk", "seven_day")):
        used = (rate_limits.get(key) or {}).get("used_percentage")
        left = percent_left(used)
        if left is not None:
            limits.append(
                dim + label + reset + " " + _bar(left, color) + " "
                + _display_percent(left) + "% left"
            )
    scoped = data.get("model_weekly") or {}
    scoped_left = percent_left(scoped.get("used_percentage"))
    scoped_label = str(scoped.get("label") or "").strip()
    if scoped_label and scoped_left is not None:
        limits.append(
            dim + scoped_label + reset + " " + _bar(scoped_left, color) + " "
            + _display_percent(scoped_left) + "% left"
        )

    sep = " " + dim + "|" + reset + " "
    lines = []
    if parts:
        lines.append(sep.join(parts))
    if limits:
        lines.append(sep.join(limits))
    return lines


def _default_state_dir():
    if os.environ.get("STATUSLINE_STATE_DIR"):
        return Path(os.environ["STATUSLINE_STATE_DIR"])
    if os.environ.get("LOCALAPPDATA"):
        return Path(os.environ["LOCALAPPDATA"]) / "polstools" / "statusline"
    state_home = os.environ.get("XDG_STATE_HOME")
    return Path(state_home) / "polstools" / "statusline" if state_home else Path.home() / ".local" / "state" / "polstools" / "statusline"


def paths():
    state_dir = _default_state_dir()
    install_dir = Path(os.environ.get("STATUSLINE_INSTALL_DIR") or state_dir / "installed-v1")
    return {
        "claude": Path(os.environ.get("STATUSLINE_CLAUDE_SETTINGS") or Path.home() / ".claude" / "settings.json"),
        "codex": Path(os.environ.get("STATUSLINE_CODEX_CONFIG") or Path.home() / ".codex" / "config.toml"),
        "state": state_dir,
        "rollback": state_dir / ROLLBACK_NAME,
        "renderer": install_dir / "claude-statusline.ps1",
        "profile_label": install_dir / "skill-profile-label.py",
        "profile_lib": install_dir / "skill_activation.py",
        "profile_policy": install_dir / "skill-activation-v1.json",
        "ccstatusline": Path(
            os.environ.get("STATUSLINE_CCSTATUSLINE_CONFIG")
            or Path.home() / ".config" / "ccstatusline" / "settings.json"
        ),
    }


def _stage_write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = data.encode("utf-8") if isinstance(data, str) else data
    descriptor, temporary = tempfile.mkstemp(prefix="." + path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        if path.exists():
            shutil.copymode(path, temporary)
        return Path(temporary)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def atomic_write(path, data):
    temporary = _stage_write(path, data)
    try:
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def atomic_write_many(changes):
    """Stage all writes, then restore every committed target after any failure."""
    prepared = []
    seen = set()
    try:
        for path, data in changes:
            path = Path(path)
            if path in seen:
                raise ValueError("transaction contains a duplicate target")
            seen.add(path)
            payload = data.encode("utf-8") if isinstance(data, str) else data
            existed = path.exists()
            original = path.read_bytes() if existed else None
            if original == payload:
                continue
            item = {
                "path": path,
                "existed": existed,
                "original": original,
                "new": None,
                "rollback": None,
            }
            prepared.append(item)
            item["new"] = _stage_write(path, payload)
            if existed:
                item["rollback"] = _stage_write(path, original)

        committed = []
        try:
            for item in prepared:
                path = item["path"]
                current_exists = path.exists()
                current = path.read_bytes() if current_exists else None
                if current_exists != item["existed"] or current != item["original"]:
                    raise OSError("configuration changed while statusline apply was running")
                os.replace(item["new"], path)
                item["new"] = None
                committed.append(item)
        except Exception as error:
            rollback_failed = False
            for item in reversed(committed):
                try:
                    if item["existed"]:
                        os.replace(item["rollback"], item["path"])
                        item["rollback"] = None
                    elif item["path"].exists():
                        os.unlink(item["path"])
                except Exception:
                    rollback_failed = True
            if rollback_failed:
                raise OSError("statusline apply failed and could not restore every target") from error
            raise
    finally:
        for item in prepared:
            for key in ("new", "rollback"):
                temporary = item.get(key)
                if temporary is not None:
                    try:
                        os.unlink(temporary)
                    except OSError:
                        pass


def load_claude(path):
    if not path.exists():
        return {}
    with path.open(encoding="utf-8-sig") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise ValueError("Claude settings must contain a JSON object")
    return value


def renderer_command(renderer_path):
    normalized = renderer_path.resolve().as_posix()
    if os.name == "nt":
        return 'powershell -NoProfile -ExecutionPolicy Bypass -File "' + normalized + '"'
    return 'pwsh -NoProfile -File "' + normalized + '"'


def desired_claude(renderer_path):
    value = copy.deepcopy(PROFILE["claudeSettings"])
    value["command"] = renderer_command(renderer_path)
    return value


def claude_provider(current, desired):
    """Classify the configured Claude renderer without executing it."""
    if current == desired:
        return "bundled"
    if current is None:
        return "missing"
    if not isinstance(current, dict) or current.get("type") != "command":
        return "external"
    command = current.get("command")
    if not isinstance(command, str) or not command.strip():
        return "external"
    try:
        argv = shlex.split(command, posix=os.name != "nt")
    except ValueError:
        return "external"
    executable = Path(argv[0].strip('"')).name.lower() if argv else ""
    return "ccstatusline" if executable in {"ccstatusline", "ccstatusline.exe"} else "external"


def profile_command(label_path):
    argv = [sys.executable, str(label_path.resolve())]
    return subprocess.list2cmdline(argv) if os.name == "nt" else shlex.join(argv)


def ccstatusline_config_path(current, target):
    command = current.get("command") if isinstance(current, dict) else None
    if not isinstance(command, str):
        raise ValueError("Claude ccstatusline command is invalid")
    try:
        argv = shlex.split(command, posix=os.name != "nt")
    except ValueError as error:
        raise ValueError("Claude ccstatusline command is invalid") from error
    if "--config" in argv:
        index = argv.index("--config")
        if index + 1 >= len(argv) or argv[index + 1].startswith("--"):
            raise ValueError("Claude ccstatusline --config path is missing")
        configured = Path(argv[index + 1].strip('"')).expanduser()
        if not configured.is_absolute():
            raise ValueError("Claude ccstatusline --config path must be absolute")
        return configured.resolve()
    return target["ccstatusline"].expanduser().resolve()


def load_ccstatusline(path):
    if not path.is_file():
        raise ValueError("ccstatusline settings are missing")
    try:
        with path.open(encoding="utf-8-sig") as handle:
            value = json.load(handle)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ValueError("ccstatusline settings are unreadable or malformed") from error
    if not isinstance(value, dict):
        raise ValueError("ccstatusline settings must contain a JSON object")
    lines = value.get("lines")
    if not isinstance(lines, list) or not lines or not all(
        isinstance(line, list) for line in lines
    ):
        raise ValueError("ccstatusline settings have an unsupported lines shape")
    for line in lines:
        for widget in line:
            if (
                not isinstance(widget, dict)
                or not isinstance(widget.get("id"), str)
                or not isinstance(widget.get("type"), str)
            ):
                raise ValueError("ccstatusline settings contain an invalid widget")
    return value


def _owned_profile_widget(widget):
    metadata = widget.get("metadata") if isinstance(widget, dict) else None
    return isinstance(metadata, dict) and metadata.get("p.owner") == PROFILE_OWNER


def desired_profile_widget(target):
    return {
        "id": PROFILE_WIDGET_ID,
        "type": "custom-command",
        "color": "brightBlack",
        "dim": True,
        "commandPath": profile_command(target["profile_label"]),
        "maxWidth": 3,
        "timeout": 500,
        "metadata": {"p.owner": PROFILE_OWNER},
    }


def set_profile_widget(settings, widget):
    updated = copy.deepcopy(settings)
    previous = []
    for line_index, line in enumerate(updated["lines"]):
        kept = []
        for widget_index, current in enumerate(line):
            if _owned_profile_widget(current):
                previous.append(
                    {"line": line_index, "index": widget_index, "widget": current}
                )
            else:
                kept.append(current)
        updated["lines"][line_index] = kept
    target_line = next(
        (index for index, line in enumerate(updated["lines"]) if line), 0
    )
    updated["lines"][target_line].append(copy.deepcopy(widget))
    return updated, previous


def restore_profile_widgets(settings, applied, previous):
    current = []
    for line_index, line in enumerate(settings["lines"]):
        for widget_index, widget in enumerate(line):
            if _owned_profile_widget(widget):
                current.append((line_index, widget_index, widget))
    if len(current) != 1 or current[0][2] != applied:
        return None
    restored = copy.deepcopy(settings)
    del restored["lines"][current[0][0]][current[0][1]]
    for item in sorted(previous, key=lambda value: (value["line"], value["index"])):
        line_index = item.get("line")
        widget_index = item.get("index")
        widget = item.get("widget")
        if (
            not isinstance(line_index, int)
            or not isinstance(widget_index, int)
            or not isinstance(widget, dict)
        ):
            raise ValueError("rollback metadata contains an invalid profile widget")
        if line_index < 0 or line_index >= len(restored["lines"]):
            raise ValueError("rollback profile widget line is invalid")
        restored["lines"][line_index].insert(
            min(max(widget_index, 0), len(restored["lines"][line_index])), widget
        )
    return restored


def profile_bundle_changes(target, include_renderer=False):
    sources = (
        (target["profile_label"], PROFILE_LABEL_SOURCE),
        (target["profile_lib"], ACTIVATION_LIB_SOURCE),
        (target["profile_policy"], ACTIVATION_PROFILE_SOURCE),
    )
    if include_renderer:
        sources = ((target["renderer"], RENDERER_SOURCE),) + sources
    for _, source in sources:
        if not source.is_file():
            raise FileNotFoundError("status profile source is missing")
    return [(destination, source.read_bytes()) for destination, source in sources]


_SECTION_RE = re.compile(r"^\s*\[([^\]]+)\]\s*(?:#.*)?$")
_STATUS_RE = re.compile(r"^\s*status_line\s*=")


_BASIC_ESCAPES = {
    '"': '"',
    "\\": "\\",
    "b": "\b",
    "t": "\t",
    "n": "\n",
    "f": "\f",
    "r": "\r",
}


def _skip_array_space(source, index):
    while index < len(source):
        if source[index] in " \t\r\n":
            index += 1
        elif source[index] == "#":
            newline = source.find("\n", index)
            index = len(source) if newline < 0 else newline + 1
        else:
            break
    return index


def _parse_basic_string(source, index):
    if source.startswith('"""', index):
        raise ValueError("multiline strings are unsupported in Codex tui.status_line")
    index += 1
    value = []
    while index < len(source):
        char = source[index]
        if char == '"':
            return "".join(value), index + 1
        if char == "\\":
            index += 1
            if index >= len(source):
                break
            escape = source[index]
            if escape in _BASIC_ESCAPES:
                value.append(_BASIC_ESCAPES[escape])
                index += 1
                continue
            if escape in ("u", "U"):
                width = 4 if escape == "u" else 8
                digits = source[index + 1:index + 1 + width]
                if len(digits) != width or not re.fullmatch(r"[0-9A-Fa-f]+", digits):
                    raise ValueError("invalid Unicode escape in Codex tui.status_line")
                codepoint = int(digits, 16)
                if codepoint > 0x10FFFF or 0xD800 <= codepoint <= 0xDFFF:
                    raise ValueError("invalid Unicode escape in Codex tui.status_line")
                value.append(chr(codepoint))
                index += width + 1
                continue
            raise ValueError("invalid escape in Codex tui.status_line")
        if ord(char) < 0x20 and char != "\t":
            raise ValueError("control character in Codex tui.status_line")
        value.append(char)
        index += 1
    raise ValueError("unterminated string in Codex tui.status_line")


def _parse_literal_string(source, index):
    if source.startswith("'''", index):
        raise ValueError("multiline strings are unsupported in Codex tui.status_line")
    end = source.find("'", index + 1)
    if end < 0:
        raise ValueError("unterminated string in Codex tui.status_line")
    value = source[index + 1:end]
    if any(ord(char) < 0x20 and char != "\t" for char in value):
        raise ValueError("control character in Codex tui.status_line")
    return value, end + 1


def _parse_status_array(source):
    """Parse the TOML string-array subset accepted by Codex status_line."""
    index = _skip_array_space(source, 0)
    if index >= len(source) or source[index] != "[":
        raise ValueError("Codex tui.status_line must be a string array or null")
    index = _skip_array_space(source, index + 1)
    values = []
    while index < len(source) and source[index] != "]":
        if source[index] == '"':
            value, index = _parse_basic_string(source, index)
        elif source[index] == "'":
            value, index = _parse_literal_string(source, index)
        else:
            raise ValueError("Codex tui.status_line must contain only strings")
        values.append(value)
        index = _skip_array_space(source, index)
        if index < len(source) and source[index] == ",":
            index = _skip_array_space(source, index + 1)
            continue
        if index >= len(source) or source[index] != "]":
            raise ValueError("invalid Codex tui.status_line string array")
    if index >= len(source):
        raise ValueError("unterminated Codex tui.status_line string array")
    index = _skip_array_space(source, index + 1)
    if index != len(source):
        raise ValueError("unexpected content after Codex tui.status_line")
    return tuple(values)


def _validate_toml(text):
    if tomllib is not None and text.strip():
        tomllib.loads(text)


def _toml_lines(text):
    return text.splitlines(keepends=True)


def _newline(text):
    return "\r\n" if "\r\n" in text else "\n"


def _sections(lines):
    found = []
    for index, line in enumerate(lines):
        match = _SECTION_RE.match(line.rstrip("\r\n"))
        if match:
            found.append((match.group(1).strip(), index))
    return found


def _tui_bounds(lines):
    sections = _sections(lines)
    matches = [pos for pos, (name, _) in enumerate(sections) if name == "tui"]
    if len(matches) > 1:
        raise ValueError("Codex config contains duplicate [tui] sections")
    if matches:
        pos = matches[0]
        start = sections[pos][1]
        end = sections[pos + 1][1] if pos + 1 < len(sections) else len(lines)
        return start, end
    return None


def _array_balance(fragment):
    balance = 0
    quote = None
    escaped = False
    for char in fragment:
        if quote:
            if escaped:
                escaped = False
            elif char == "\\" and quote == '"':
                escaped = True
            elif char == quote:
                quote = None
        elif char in ('"', "'"):
            quote = char
        elif char == "#":
            break
        elif char == "[":
            balance += 1
        elif char == "]":
            balance -= 1
    return balance


def _status_bounds(lines, section):
    if section is None:
        return None
    _, end = section
    start = section[0] + 1
    found = []
    for index in range(start, end):
        line = lines[index]
        if not _STATUS_RE.match(line):
            continue
        balance = _array_balance(line.split("=", 1)[1])
        stop = index + 1
        while balance > 0 and stop < end:
            balance += _array_balance(lines[stop])
            stop += 1
        found.append((index, stop))
    if len(found) > 1:
        raise ValueError("Codex config contains duplicate tui.status_line settings")
    return found[0] if found else None


def _status_value(lines, bounds):
    assignment = "".join(lines[bounds[0]:bounds[1]])
    return _parse_status_array(assignment.split("=", 1)[1])


def read_codex_status(text):
    _validate_toml(text)
    lines = _toml_lines(text)
    bounds = _status_bounds(lines, _tui_bounds(lines))
    return _status_value(lines, bounds) if bounds else None


def set_codex_status(text, items):
    _validate_toml(text)
    lines = _toml_lines(text)
    newline = _newline(text)
    section = _tui_bounds(lines)
    bounds = _status_bounds(lines, section)
    if bounds:
        _status_value(lines, bounds)
    previous = {
        "present": bounds is not None,
        "raw": "".join(lines[bounds[0]:bounds[1]]) if bounds else None,
        "sectionPresent": section is not None,
    }
    literal = "status_line = [" + ", ".join(json.dumps(item) for item in items) + "]" + newline
    if bounds:
        lines[bounds[0]:bounds[1]] = [literal]
    elif section:
        insert_at = section[1]
        if insert_at > 0 and lines[insert_at - 1] and not lines[insert_at - 1].endswith(("\n", "\r")):
            lines[insert_at - 1] += newline
        lines.insert(insert_at, literal)
    else:
        if lines and lines[-1].strip():
            if not lines[-1].endswith(("\n", "\r")):
                lines[-1] += newline
            lines.append(newline)
        lines.extend(["[tui]" + newline, literal])
    updated = "".join(lines)
    _validate_toml(updated)
    read_codex_status(updated)
    return updated, previous


def restore_codex_status(text, previous):
    lines = _toml_lines(text)
    section = _tui_bounds(lines)
    bounds = _status_bounds(lines, section)
    if not bounds:
        raise ValueError("Codex status line is missing during restore")
    if previous.get("present"):
        raw = previous.get("raw")
        if not isinstance(raw, str):
            raise ValueError("rollback metadata is missing the prior Codex setting")
        lines[bounds[0]:bounds[1]] = _toml_lines(raw)
    else:
        del lines[bounds[0]:bounds[1]]
        if not previous.get("sectionPresent"):
            section = _tui_bounds(lines)
            if section:
                body = lines[section[0] + 1:section[1]]
                if all(not line.strip() or line.lstrip().startswith("#") for line in body):
                    del lines[section[0]:section[1]]
    restored = "".join(lines)
    _validate_toml(restored)
    if previous.get("present"):
        read_codex_status(restored)
    return restored


def load_rollback(path):
    if not path.exists():
        return None
    with path.open(encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict) or value.get("schema") not in {1, 2}:
        raise ValueError("rollback metadata has an unsupported shape")
    return value


def profile_sync():
    target = paths()
    claude = load_claude(target["claude"])
    desired_c = desired_claude(target["renderer"])
    current_claude = claude.get("statusLine")
    provider = claude_provider(current_claude, desired_c)
    if provider not in {"bundled", "ccstatusline"}:
        print("profile indicator not updated: Claude has no supported active renderer")
        return 1
    changes = profile_bundle_changes(target, include_renderer=provider == "bundled")
    if provider == "ccstatusline":
        cc_path = ccstatusline_config_path(current_claude, target)
        cc_settings = load_ccstatusline(cc_path)
        cc_updated, _ = set_profile_widget(
            cc_settings, desired_profile_widget(target)
        )
        changes.append(
            (cc_path, json.dumps(cc_updated, indent=2, ensure_ascii=False) + "\n")
        )
    atomic_write_many(changes)
    print("profile indicator synchronized for Claude " + provider)
    return 0


def apply_config():
    target = paths()
    claude = load_claude(target["claude"])
    codex_text = target["codex"].read_text(encoding="utf-8-sig") if target["codex"].exists() else ""
    codex_current = read_codex_status(codex_text)
    desired_c = desired_claude(target["renderer"])
    current_claude = claude.get("statusLine")
    provider = claude_provider(current_claude, desired_c)
    if provider == "external":
        print("not applied: Claude statusLine is externally managed; no settings changed")
        return 1
    manage_claude = provider != "ccstatusline"
    if manage_claude and not RENDERER_SOURCE.is_file():
        raise FileNotFoundError("bundled Claude renderer is missing")
    previous_rollback = load_rollback(target["rollback"])

    cc_path = None
    cc_settings = None
    cc_updated = None
    cc_previous = None
    manage_cc = False
    profile_widget = desired_profile_widget(target)
    if provider == "ccstatusline":
        cc_path = ccstatusline_config_path(current_claude, target)
        cc_settings = load_ccstatusline(cc_path)
        cc_updated, cc_previous = set_profile_widget(cc_settings, profile_widget)
        manage_cc = cc_updated != cc_settings

    codex_updated, codex_previous = set_codex_status(codex_text, CODEX_STATUS_LINE)
    claude_previous = (
        {"present": "statusLine" in claude, "value": current_claude}
        if manage_claude else None
    )

    if manage_claude and previous_rollback and current_claude == desired_c:
        claude_previous = previous_rollback["previous"]["claude"]
    if previous_rollback and codex_current == CODEX_STATUS_LINE:
        codex_previous = previous_rollback["previous"]["codex"]
    if (
        previous_rollback
        and provider == "ccstatusline"
        and not manage_cc
        and previous_rollback.get("managed", {}).get("ccstatusline")
        and previous_rollback.get("applied", {}).get("cc_widget") == profile_widget
    ):
        manage_cc = True
        cc_previous = previous_rollback["previous"]["cc_widgets"]

    rollback = {
        "schema": 2,
        "managed": {
            "claude": manage_claude,
            "codex": True,
            "ccstatusline": manage_cc,
        },
        "applied": {
            "claude": desired_c if manage_claude else None,
            "codex": list(CODEX_STATUS_LINE),
            "cc_widget": profile_widget if manage_cc else None,
        },
        "previous": {
            "claude": claude_previous,
            "codex": codex_previous,
            "cc_widgets": cc_previous if manage_cc else None,
        },
    }
    rollback_text = json.dumps(rollback, indent=2, ensure_ascii=False) + "\n"
    changes = [(target["rollback"], rollback_text)]
    changes.extend(profile_bundle_changes(target, include_renderer=manage_claude))
    if codex_text != codex_updated:
        changes.append((target["codex"], codex_updated))
    if manage_claude and current_claude != desired_c:
        claude["statusLine"] = desired_c
        changes.append(
            (target["claude"], json.dumps(claude, indent=2, ensure_ascii=False) + "\n")
        )
    if provider == "ccstatusline" and cc_updated != cc_settings:
        changes.append(
            (cc_path, json.dumps(cc_updated, indent=2, ensure_ascii=False) + "\n")
        )
    atomic_write_many(changes)
    if manage_claude:
        print("applied: Claude statusLine and Codex tui.status_line aligned")
    else:
        print(
            "applied: Claude ccstatusline preserved with p profile indicator; "
            "Codex tui.status_line aligned"
        )
    return 0


def check_config():
    target = paths()
    drift = []
    try:
        desired_c = desired_claude(target["renderer"])
        claude = load_claude(target["claude"])
        provider = claude_provider(claude.get("statusLine"), desired_c)
        if provider not in {"bundled", "ccstatusline"}:
            drift.append("Claude setting")
        codex_text = target["codex"].read_text(encoding="utf-8-sig") if target["codex"].exists() else ""
        if read_codex_status(codex_text) != CODEX_STATUS_LINE:
            drift.append("Codex setting")
        if provider == "bundled" and (
            not target["renderer"].is_file()
            or target["renderer"].read_bytes() != RENDERER_SOURCE.read_bytes()
        ):
            drift.append("Claude renderer")
        if provider in {"bundled", "ccstatusline"}:
            for destination, source in (
                (target["profile_label"], PROFILE_LABEL_SOURCE),
                (target["profile_lib"], ACTIVATION_LIB_SOURCE),
                (target["profile_policy"], ACTIVATION_PROFILE_SOURCE),
            ):
                if (
                    not destination.is_file()
                    or destination.read_bytes() != source.read_bytes()
                ):
                    drift.append("Claude profile indicator")
                    break
        if provider == "ccstatusline":
            cc_path = ccstatusline_config_path(claude.get("statusLine"), target)
            cc_settings = load_ccstatusline(cc_path)
            cc_updated, _ = set_profile_widget(
                cc_settings, desired_profile_widget(target)
            )
            if cc_updated != cc_settings:
                drift.append("Claude profile widget")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print("cannot check: " + str(error), file=sys.stderr)
        return 2
    if drift:
        print("drift: " + ", ".join(drift))
        return 1
    if provider == "ccstatusline":
        print(
            "compatible: Claude ccstatusline and p profile indicator preserved; "
            "Codex matches aligned-v1"
        )
    else:
        print("aligned: Claude and Codex status lines match aligned-v1")
    return 0


def sync_config():
    checked = check_config()
    if checked != 1:
        return checked
    applied = apply_config()
    return check_config() if applied == 0 else applied


def restore_config():
    target = paths()
    try:
        rollback = load_rollback(target["rollback"])
        if rollback is None:
            print("cannot restore: no rollback metadata", file=sys.stderr)
            return 2
        claude = load_claude(target["claude"])
        codex_text = target["codex"].read_text(encoding="utf-8-sig") if target["codex"].exists() else ""
        skipped = []
        manage_claude = rollback.get("managed", {}).get("claude", True)
        if manage_claude:
            if claude.get("statusLine") == rollback["applied"]["claude"]:
                previous = rollback["previous"]["claude"]
                if previous.get("present"):
                    claude["statusLine"] = previous.get("value")
                else:
                    claude.pop("statusLine", None)
                atomic_write(target["claude"], json.dumps(claude, indent=2, ensure_ascii=False) + "\n")
            else:
                skipped.append("Claude setting changed after apply")

        if read_codex_status(codex_text) == tuple(rollback["applied"]["codex"]):
            atomic_write(target["codex"], restore_codex_status(codex_text, rollback["previous"]["codex"]))
        else:
            skipped.append("Codex setting changed after apply")
        if rollback.get("managed", {}).get("ccstatusline"):
            current_claude = claude.get("statusLine")
            cc_path = ccstatusline_config_path(current_claude, target)
            cc_settings = load_ccstatusline(cc_path)
            restored_cc = restore_profile_widgets(
                cc_settings,
                rollback["applied"]["cc_widget"],
                rollback["previous"]["cc_widgets"],
            )
            if restored_cc is None:
                skipped.append("ccstatusline profile widget changed after apply")
            else:
                atomic_write(
                    cc_path,
                    (json.dumps(restored_cc, indent=2, ensure_ascii=False) + "\n").encode("utf-8"),
                )
        if skipped:
            print("not restored: " + "; ".join(skipped))
            return 1
        print("restored: prior managed statusline settings")
        return 0
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        print("cannot restore: " + str(error), file=sys.stderr)
        return 2


def preview():
    sample = {
        "model": {"display_name": "model"},
        "effort": {"level": "high"},
        "workspace": {"current_dir": "project", "git_branch": "main"},
        "context_window": {"remaining_percentage": 72},
        "rate_limits": {
            "five_hour": {"used_percentage": 36},
            "seven_day": {"used_percentage": 19},
        },
        "model_weekly": {"label": "model-week", "used_percentage": 12},
    }
    print("Claude (two lines)")
    for line in render_claude(sample, color=sys.stdout.isatty()):
        print(line)
    print("Codex (native footer)")
    print("model high | project | main | 72% left | 64% left | 81% left")
    print("Codex identifiers: " + ", ".join(CODEX_STATUS_LINE))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command", choices=("sync", "check", "preview", "apply", "profile-sync", "restore")
    )
    args = parser.parse_args(argv)
    try:
        return {
            "sync": sync_config,
            "check": check_config,
            "preview": preview,
            "apply": apply_config,
            "profile-sync": profile_sync,
            "restore": restore_config,
        }[args.command]()
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print("statusline-ctl: cannot run: " + str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
