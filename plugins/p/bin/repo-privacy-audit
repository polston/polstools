#!/usr/bin/env sh
# repo-privacy-audit — read-only sweep of every place a git repository can hold
# private data. Counts and locations only; never a matched value. The sweep is
# repo_privacy_audit.py beside this file: one pass over every distinct blob,
# with each category matched by the same regex engine on every platform.
#
# Usage: repo-privacy-audit [-C <repo>] [-p <pattern>]... [-k] [-v]   (-h: help)
# Exit: 0 = every category read zero. 1 = at least one hit. 2 = could not run.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec sh "$script_dir/python-launcher" -B "$script_dir/repo_privacy_audit.py" "$@"
