#!/usr/bin/env python3
"""Read-only cross-harness health check for the p plugin.

Checks package metadata, installed versions, enabled state, obsolete polstools
plugin IDs in each harness's plugin list and Codex's config, installed file
content, the skill-activation policy, the statusline bundle, and the exact
hook commands of every harness with a p hook contract. Output never includes
installation paths or raw command stderr.

Exit: 0 ran clean and flagged nothing, 1 ran clean and flagged drift, 2 could
not complete an available harness check.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from typing import NamedTuple


for _stream in (sys.stdin, sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8")


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
RUN = subprocess.run  # harness CLI runner; tests substitute a fake harness
PLUGIN_ID = "p@polstools"
HOOK_EVENTS = ("SessionStart", "UserPromptSubmit")
HARNESS_LABELS = {"claude": "Claude", "codex": "Codex", "agy": "Antigravity"}
# The hook contract each harness loads from an installed p. A harness mapped to
# None has no p hook yet; the doctor says so explicitly instead of staying
# silent. Adding a harness's contract here is the only change the probe needs.
HOOK_CONTRACTS = {
    "claude": {
        "catalog": ("hooks", "hooks.json"),
        "events": HOOK_EVENTS,
        "session_env": "CLAUDE_CODE_SESSION_ID",
    },
    "codex": {
        "catalog": ("hooks", "hooks.json"),
        "events": HOOK_EVENTS,
        "session_env": "CODEX_SESSION_ID",
    },
    "agy": None,
}
CONTENT_IGNORED_PARTS = {"__pycache__", ".in_use", ".git", ".DS_Store"}
CODEX_CONFIG_TABLE_RE = re.compile(
    r"""^\s*\[\s*(plugins|hooks\s*\.\s*state)\s*\.\s*(?:"([^"]+)"|'([^']+)')\s*\]"""
)


class Check(NamedTuple):
    key: str
    status: str
    summary: str
    fix: str = ""


def _manifest_version(plugin_root=PLUGIN_ROOT):
    path = Path(plugin_root) / ".claude-plugin" / "plugin.json"
    with path.open(encoding="utf-8") as handle:
        value = json.load(handle)
    version = value.get("version") if isinstance(value, dict) else None
    if not isinstance(version, str) or not version.strip():
        raise ValueError("plugin manifest has no version")
    return version


def _read_plugin_manifest(path):
    with Path(path).open(encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise ValueError("plugin manifest must be an object")
    for field in ("name", "version", "description"):
        if not isinstance(value.get(field), str) or not value[field].strip():
            raise ValueError("plugin manifest field is missing")
    return value


def package_metadata_checks(plugin_root=PLUGIN_ROOT):
    root = Path(plugin_root)
    try:
        claude = _read_plugin_manifest(root / ".claude-plugin" / "plugin.json")
    except (OSError, ValueError, json.JSONDecodeError, UnicodeError):
        return [
            Check(
                "package.claude_manifest",
                "ERROR",
                "the Claude plugin manifest is missing or malformed",
            ),
            Check(
                "package.universal_manifest",
                "ERROR",
                "universal metadata cannot be compared without the Claude manifest",
            ),
        ]
    checks = [Check(
        "package.claude_manifest",
        "PASS",
        "Claude package metadata declares p version %s" % claude["version"],
    )]
    try:
        universal = _read_plugin_manifest(root / ".codex-plugin" / "plugin.json")
    except (OSError, ValueError, json.JSONDecodeError, UnicodeError):
        checks.append(Check(
            "package.universal_manifest",
            "ERROR",
            "the universal plugin manifest is missing or malformed",
        ))
        return checks
    matches = all(
        universal.get(field) == claude.get(field)
        for field in ("name", "version", "description", "keywords")
    )
    checks.append(Check(
        "package.universal_manifest",
        "PASS" if matches else "FAIL",
        (
            "universal metadata matches the Claude package"
            if matches
            else "universal metadata version, description, or keywords differ from Claude"
        ),
    ))
    agy_path = root / "plugin.json"
    if agy_path.is_file():
        try:
            agy = _read_plugin_manifest(agy_path)
            matches_agy = all(
                agy.get(field) == claude.get(field)
                for field in ("name", "version", "description", "keywords")
            )
            checks.append(Check(
                "package.antigravity_manifest",
                "PASS" if matches_agy else "FAIL",
                (
                    "Antigravity metadata matches the Claude package"
                    if matches_agy
                    else "Antigravity metadata version, description, or keywords differ from Claude"
                ),
            ))
        except (OSError, ValueError, json.JSONDecodeError, UnicodeError):
            checks.append(Check(
                "package.antigravity_manifest",
                "ERROR",
                "the Antigravity plugin manifest is malformed",
            ))
    return checks


def marketplace_version(root):
    try:
        path = Path(root) / ".claude-plugin" / "marketplace.json"
        with path.open(encoding="utf-8") as handle:
            value = json.load(handle)
        entries = value.get("plugins") if isinstance(value, dict) else None
        entry = next(
            item for item in entries or []
            if isinstance(item, dict) and item.get("name") == "p"
        )
        version = entry.get("version")
        return version if isinstance(version, str) and version else None
    except (OSError, ValueError, StopIteration, TypeError, json.JSONDecodeError):
        return None


def normalize_claude_plugins(payload):
    if not isinstance(payload, list):
        raise ValueError("Claude plugin list JSON must be an array")
    result = []
    for item in payload:
        if not isinstance(item, dict):
            continue
        result.append({
            "id": item.get("id") or item.get("pluginId") or "",
            "version": item.get("version") or "",
            "enabled": bool(item.get("enabled")),
            "root": item.get("installPath") or "",
            "scope": item.get("scope") or "user",
        })
    return result


def codex_installed_root(item):
    """The directory Codex loads an installed plugin from.

    An explicit installed-path field wins. Otherwise it is the versioned cache
    copy, <CODEX_HOME or ~/.codex>/plugins/cache/<marketplace>/<name>/<version>,
    the same layout p-update's codex_cache_root() builds (a unit test keeps the
    two in step). `source.path` is where the plugin came from, never what is
    installed, so it is not used.
    """
    explicit = item.get("installedPath")
    if explicit:
        return str(explicit)
    version = item.get("version")
    if not version:
        return ""
    name = item.get("name") or str(item.get("pluginId") or "").split("@", 1)[0] or "p"
    marketplace = item.get("marketplaceName") or PLUGIN_ID.split("@", 1)[1]
    home = os.environ.get("CODEX_HOME") or str(Path.home() / ".codex")
    return str(Path(home) / "plugins" / "cache" / marketplace / name / str(version))


def normalize_codex_plugins(payload):
    if not isinstance(payload, dict) or not isinstance(payload.get("installed"), list):
        raise ValueError("Codex plugin list JSON must contain installed[]")
    result = []
    for item in payload["installed"]:
        if not isinstance(item, dict):
            continue
        result.append({
            "id": item.get("pluginId") or item.get("id") or "",
            "version": item.get("version") or "",
            "enabled": bool(item.get("enabled")),
            "root": codex_installed_root(item),
            "scope": "user",
        })
    return result


def agy_config_root():
    """Antigravity keeps imported plugins and its config under this directory."""
    return Path.home() / ".gemini" / "config"


def normalize_agy_plugins(payload):
    """Normalize `agy plugin list`; version and root come from the imported copy.

    The list itself carries only name, source, importedAt, and components.
    """
    if not isinstance(payload, dict) or not isinstance(payload.get("imports"), list):
        raise ValueError("Antigravity plugin list JSON must contain imports[]")
    result = []
    config_path = agy_config_root() / "config.json"
    enabled_map = {}
    if config_path.is_file():
        try:
            with config_path.open(encoding="utf-8") as handle:
                cfg = json.load(handle)
            enabled_map = cfg.get("plugins") or {}
        except (OSError, ValueError):
            pass
    for item in payload["imports"]:
        if not isinstance(item, dict):
            continue
        name = item.get("name") or ""
        root = agy_config_root() / "plugins" / name
        version = ""
        manifest_path = root / "plugin.json"
        if manifest_path.is_file():
            try:
                with manifest_path.open(encoding="utf-8") as handle:
                    mdata = json.load(handle)
                version = mdata.get("version") or ""
            except (OSError, ValueError):
                pass
        enabled = True
        if name in enabled_map and isinstance(enabled_map[name], dict):
            enabled = enabled_map[name].get("enabled", True)
        result.append({
            "id": PLUGIN_ID if name == "p" else (name + "@polstools"),
            "version": version,
            "enabled": enabled,
            "root": str(root) if root.is_dir() else "",
            "scope": "user",
        })
    return result


def _scope(value):
    return value if value in {"user", "project", "local", "managed"} else "user"


def _version_fix(harness, scope="user"):
    return "Run p's `p-update` guard, then start new sessions."


def _remove_fix(harness, plugin_ids, scope="user"):
    if harness == "claude":
        commands = [
            "`claude plugin uninstall %s --scope %s`" % (item, _scope(scope))
            for item in plugin_ids
        ]
    elif harness == "codex":
        commands = ["`codex plugin remove %s`" % item for item in plugin_ids]
    else:
        commands = ["`agy plugin uninstall %s`" % item for item in plugin_ids]
    return "Run " + ", then ".join(commands) + "."


def evaluate_harness(harness, plugins, expected_version):
    label = HARNESS_LABELS.get(harness, harness.capitalize())
    checks = []
    installed = [item for item in plugins if item.get("id") == PLUGIN_ID]
    obsolete = sorted({
        item.get("id") for item in plugins
        if isinstance(item.get("id"), str)
        and item.get("id").endswith("@polstools")
        and item.get("id") != PLUGIN_ID
    })
    default_scope = installed[0].get("scope", "user") if installed else "user"

    if not installed:
        checks.append(Check(
            harness + ".install", "SKIP",
            "%s does not have p@polstools installed" % label,
        ))
    elif len(installed) > 1:
        checks.append(Check(
            harness + ".install", "FAIL",
            "%s reports duplicate p@polstools installations" % label,
            _version_fix(harness, default_scope),
        ))
    elif not installed[0].get("enabled"):
        checks.append(Check(
            harness + ".install", "FAIL",
            "%s has p@polstools disabled" % label,
            "Enable p@polstools, then start a new session.",
        ))
    else:
        checks.append(Check(
            harness + ".install", "PASS",
            "%s has one enabled p@polstools installation" % label,
        ))

    if installed:
        actual = str(installed[0].get("version") or "unknown")
        if actual == expected_version:
            checks.append(Check(
                harness + ".version", "PASS",
                "%s p version %s matches expected" % (label, actual),
            ))
        else:
            checks.append(Check(
                harness + ".version", "FAIL",
                "%s p version %s does not match expected %s"
                % (label, actual, expected_version),
                _version_fix(harness, default_scope),
            ))

    if obsolete:
        checks.append(Check(
            harness + ".obsolete", "FAIL",
            "%s still registers obsolete IDs: %s"
            % (label, ", ".join(obsolete)),
            _remove_fix(harness, obsolete, default_scope),
        ))
    else:
        checks.append(Check(
            harness + ".obsolete", "PASS",
            "%s has no obsolete polstools plugin IDs" % label,
        ))
    return checks


def _hook_command(raw, plugin_root):
    replaced = raw.replace(
        "${CLAUDE_PLUGIN_ROOT}", Path(plugin_root).resolve().as_posix()
    )
    return shlex.split(replaced, posix=True)


def _event_key(event):
    result = []
    for char in event:
        if char.isupper() and result:
            result.append("_")
        result.append(char.lower())
    return "".join(result)


def probe_plugin_hooks(harness, plugin_root, runner=subprocess.run, contract=None):
    contract = contract or HOOK_CONTRACTS.get(harness)
    if contract is None:
        return [Check(
            harness + ".hooks", "SKIP",
            "%s has no p hook contract; p's format hooks do not run there"
            % HARNESS_LABELS.get(harness, harness.capitalize()),
        )]
    plugin_root = Path(plugin_root)
    events = tuple(contract["events"])
    try:
        with plugin_root.joinpath(*contract["catalog"]).open(encoding="utf-8") as handle:
            hooks = json.load(handle).get("hooks")
        if not isinstance(hooks, dict) or set(hooks) != set(events):
            raise ValueError("hook catalog does not contain the expected events")
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        return [Check(
            harness + ".hooks", "ERROR",
            "%s installed hook catalog cannot be read" % harness.capitalize(),
            _version_fix(harness),
        )]

    checks = []
    scratch = tempfile.mkdtemp(prefix="p-doctor-format-")
    for event in events:
        key = "%s.hook.%s" % (harness, _event_key(event))
        try:
            raw = hooks[event][0]["hooks"][0]["command"]
            argv = _hook_command(raw, plugin_root)
            gate_at = argv.index("gate")
            payload = Path(argv[gate_at + 1])
            expected = payload.read_text(encoding="utf-8")
        except (IndexError, KeyError, OSError, TypeError, ValueError):
            checks.append(Check(
                key, "ERROR", "%s %s hook definition is unreadable"
                % (harness.capitalize(), event), _version_fix(harness),
            ))
            continue

        env = dict(os.environ)
        for name in ("RETRO_HOME", "P_FORMAT_HARNESS", "P_FORMAT_DEFAULT",
                     "CLAUDE_CODE_SESSION_ID", "CODEX_SESSION_ID",
                     "CODEX_THREAD_ID"):
            env.pop(name, None)
        env[contract["session_env"]] = "p-doctor-check"
        # The probe verifies wiring, not the operator's preference: force
        # the default on and isolate session flags so an off default or a
        # stale fmt-off toggle cannot make a healthy gate look broken.
        env["P_FORMAT_DEFAULT"] = "on"
        env["P_FORMAT_STATE_DIR"] = scratch
        env["P_FORMAT_CONFIG_FILE"] = os.path.join(scratch, "format.json")
        try:
            completed = runner(
                argv,
                input=json.dumps({
                    "session_id": "p-doctor-check",
                    "hook_event_name": event,
                }),
                text=True,
                encoding="utf-8",
                capture_output=True,
                env=env,
            )
        except OSError:
            checks.append(Check(
                key, "ERROR", "%s %s hook command could not start"
                % (harness.capitalize(), event),
                "Install a POSIX sh and Python 3, then rerun p doctor.",
            ))
            continue

        stderr = str(getattr(completed, "stderr", "") or "")
        code = int(getattr(completed, "returncode", 2))
        if code != 0 and "python-launcher: Python 3 not found" in stderr:
            checks.append(Check(
                key, "FAIL", "%s %s hook failed because Python 3 is unavailable"
                % (harness.capitalize(), event),
                "Install Python 3 or set POLSTOOLS_PYTHON to one executable path, then rerun p doctor.",
            ))
        elif code != 0:
            checks.append(Check(
                key, "FAIL", "%s %s hook exited %d"
                % (harness.capitalize(), event, code), _version_fix(harness),
            ))
        elif getattr(completed, "stdout", "") != expected:
            checks.append(Check(
                key, "FAIL", "%s %s hook output differs from its payload"
                % (harness.capitalize(), event), _version_fix(harness),
            ))
        else:
            checks.append(Check(
                key, "PASS", "%s %s hook exits 0 with byte-exact output"
                % (harness.capitalize(), event),
            ))
    shutil.rmtree(scratch, ignore_errors=True)
    return checks


def _find_executable(name):
    override = os.environ.get("P_DOCTOR_" + name.upper())
    if override:
        candidate = Path(override)
        return str(candidate) if candidate.is_file() else None
    found = shutil.which(name)
    if found:
        return found
    if os.name != "nt":
        candidate = Path.home() / ".local" / "bin" / name
        return str(candidate) if candidate.is_file() else None
    if name == "claude":
        candidates = [Path.home() / ".local" / "bin" / "claude.exe"]
    else:
        local = Path(os.environ.get("LOCALAPPDATA") or Path.home())
        candidates = [
            local / "Programs" / "OpenAI" / "Codex" / "bin" / "codex.exe",
        ]
    return next((str(path) for path in candidates if path.is_file()), None)


def _run_json(executable, args):
    completed = RUN(
        [executable, *args], text=True, encoding="utf-8",
        capture_output=True, check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError("command exited %d" % completed.returncode)
    try:
        return json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise ValueError("command returned invalid JSON") from error


def _local_expected_version(harness, marketplaces):
    if harness == "claude":
        if not isinstance(marketplaces, list):
            raise ValueError("Claude marketplace JSON must be an array")
        item = next((row for row in marketplaces
                     if isinstance(row, dict) and row.get("name") == "polstools"), None)
        if item and item.get("source") in {"directory", "local"}:
            return marketplace_version(item.get("path") or item.get("installLocation") or "")
        return None
    if not isinstance(marketplaces, dict) or not isinstance(
        marketplaces.get("marketplaces"), list
    ):
        raise ValueError("Codex marketplace JSON must contain marketplaces[]")
    item = next((row for row in marketplaces["marketplaces"]
                 if isinstance(row, dict) and row.get("name") == "polstools"), None)
    source = item.get("marketplaceSource") if isinstance(item, dict) else None
    if item and isinstance(source, dict) and source.get("sourceType") == "local":
        return marketplace_version(item.get("root") or "")
    return None


def tree_digest(root):
    """Map each file under root (POSIX relative path) to its SHA-256.

    Harness bookkeeping (in-use markers, bytecode caches, VCS metadata) is not
    plugin content and is ignored.
    """
    root = Path(root)
    digest = {}
    for path in root.rglob("*"):
        relative = path.relative_to(root)
        if (
            any(part in CONTENT_IGNORED_PARTS for part in relative.parts)
            or path.suffix == ".pyc"
            or not path.is_file()
        ):
            continue
        digest[relative.as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
    return digest


def _differing(left, right):
    return sorted(key for key in set(left) | set(right) if left.get(key) != right.get(key))


def _sample(paths, limit=3):
    shown = ", ".join(paths[:limit])
    return shown + (", ..." if len(paths) > limit else "")


def content_checks(roots, repo_root=None):
    """Compare installed file content, not just version strings.

    roots maps harness -> (version, installed root). With repo_root each copy is
    compared with that checkout's plugins/p; without it, copies that claim the
    same version are compared with each other.
    """
    try:
        digests = {harness: (version, tree_digest(root)) for harness, (version, root) in roots.items()}
    except OSError:
        return [Check("content", "ERROR", "installed plugin files could not be read")]
    if repo_root:
        try:
            reference = tree_digest(Path(repo_root) / "plugins" / "p")
        except OSError:
            return [Check("content", "ERROR", "the --repo-root plugin files could not be read")]
        checks = []
        for harness, (_, digest) in sorted(digests.items()):
            label = HARNESS_LABELS[harness]
            diff = _differing(digest, reference)
            checks.append(Check(
                harness + ".content", "FAIL" if diff else "PASS",
                (
                    "%s installed files differ from the --repo-root checkout in %d files: %s"
                    % (label, len(diff), _sample(diff))
                    if diff else "%s installed files match the --repo-root checkout" % label
                ),
                "Bump the version in the checkout, then run p's `p-update` guard." if diff else "",
            ))
        return checks
    checks = []
    compared = set()
    names = sorted(digests)
    for index, first in enumerate(names):
        for second in names[index + 1:]:
            (v1, d1), (v2, d2) = digests[first], digests[second]
            if v1 != v2:
                continue
            compared.update((first, second))
            diff = _differing(d1, d2)
            if diff:
                checks.append(Check(
                    "cross_harness.content", "FAIL",
                    "%s and %s both report p %s but differ in %d files: %s"
                    % (HARNESS_LABELS[first], HARNESS_LABELS[second], v1, len(diff), _sample(diff)),
                    "Bump the plugin version for any content change, then run p's `p-update` guard.",
                ))
    if not compared:
        return [Check(
            "cross_harness.content", "SKIP",
            "content comparison needs two installed copies at one version, or --repo-root",
        )]
    if not checks:
        checks.append(Check(
            "cross_harness.content", "PASS",
            "installed copies that report the same version have identical files (%s)"
            % ", ".join(HARNESS_LABELS[h] for h in sorted(compared)),
        ))
    return checks


def codex_config_path():
    home = os.environ.get("CODEX_HOME") or str(Path.home() / ".codex")
    return Path(home) / "config.toml"


def codex_config_ids(path):
    """Plugin IDs Codex config.toml still holds plugin or hook-state tables for."""
    ids = set()
    with Path(path).open(encoding="utf-8-sig") as handle:
        for line in handle:
            match = CODEX_CONFIG_TABLE_RE.match(line)
            if match:
                key = match.group(2) or match.group(3)
                ids.add(key.split(":", 1)[0] if "state" in match.group(1) else key)
    return ids


def codex_config_checks(path=None):
    path = Path(path) if path else codex_config_path()
    if not path.is_file():
        return [Check("codex.config_state", "PASS", "Codex has no config file to hold stale p state")]
    try:
        ids = codex_config_ids(path)
    except (OSError, UnicodeError):
        return [Check("codex.config_state", "ERROR", "Codex config cannot be read")]
    obsolete = sorted(
        item for item in ids if item.endswith("@polstools") and item != PLUGIN_ID
    )
    if not obsolete:
        return [Check(
            "codex.config_state", "PASS",
            "Codex config holds no plugin or hook state for obsolete polstools IDs",
        )]
    return [Check(
        "codex.config_state", "FAIL",
        "Codex config still holds plugin or hook-state tables for obsolete IDs: %s"
        % ", ".join(obsolete),
        "With Codex closed, delete the [plugins.\"<id>\"] and [hooks.state.\"<id>:...\"] "
        "tables for those IDs from Codex config.toml.",
    )]


def _run_plugin_tool(argv, runner):
    try:
        completed = runner(argv, text=True, encoding="utf-8", capture_output=True, check=False)
    except OSError:
        return None
    return int(getattr(completed, "returncode", 2))


def statusline_checks(plugin_root=PLUGIN_ROOT, runner=subprocess.run):
    code = _run_plugin_tool(
        [sys.executable, "-B", str(Path(plugin_root) / "bin" / "statusline-ctl"), "check"], runner
    )
    if code == 0:
        return [Check("statusline", "PASS", "the p statusline bundle matches this plugin, or p does not manage it")]
    if code == 1:
        return [Check(
            "statusline", "FAIL", "the installed p statusline bundle has drifted from this plugin",
            "Run the statusline-check skill, then the statusline-apply skill if it confirms drift.",
        )]
    return [Check("statusline", "ERROR", "the statusline bundle could not be checked")]


def python_checks(roots, runner=subprocess.run):
    """Ask each installed copy's launcher whether it finds an adequate Python.

    The launcher exits 0 when an interpreter at or above its floor is found and
    2 otherwise. This runs from the doctor's own environment; a hook started by
    a harness may see a different PATH.
    """
    checks = []
    for harness, (_, root) in sorted(roots.items()):
        label = HARNESS_LABELS[harness]
        code = _run_plugin_tool(
            ["sh", str(Path(root) / "bin" / "python-launcher"), "-c", "pass"], runner
        )
        if code == 0:
            checks.append(Check(
                harness + ".python", "PASS",
                "%s copy's launcher finds an adequate Python from the doctor's environment" % label,
            ))
        elif code == 2:
            checks.append(Check(
                harness + ".python", "FAIL",
                "%s copy's launcher finds no adequate Python from the doctor's environment" % label,
                "Install a supported Python 3 or set POLSTOOLS_PYTHON to one executable path.",
            ))
        else:
            checks.append(Check(
                harness + ".python", "ERROR",
                "%s copy's launcher could not be run" % label,
            ))
    return checks


def activation_checks(plugin_root=PLUGIN_ROOT, runner=subprocess.run):
    code = _run_plugin_tool(
        [sys.executable, "-B", str(Path(plugin_root) / "bin" / "skill-profile-ctl"), "validate"], runner
    )
    if code == 0:
        return [Check("activation.policy", "PASS", "the skill-activation policy is valid")]
    return [Check(
        "activation.policy", "FAIL", "the skill-activation policy failed validation",
        "Run p's `p-update` guard to reinstall p, then rerun p doctor.",
    )]


def exit_code(checks):
    statuses = {check.status for check in checks}
    if "ERROR" in statuses:
        return 2
    if "FAIL" in statuses:
        return 1
    return 0


def render(checks, expected_version):
    lines = ["p doctor — expected p %s" % expected_version]
    for check in checks:
        lines.append("[%s] %s — %s" % (check.status, check.key, check.summary))
        if check.fix:
            lines.append("  FIX " + check.fix)
    counts = {status: 0 for status in ("PASS", "FAIL", "SKIP", "ERROR")}
    for check in checks:
        counts[check.status] = counts.get(check.status, 0) + 1
    lines.append(
        "RESULT: %d passed, %d flagged, %d skipped, %d unavailable"
        % (counts["PASS"], counts["FAIL"], counts["SKIP"], counts["ERROR"])
    )
    return "\n".join(lines) + "\n"


def query_agy(executable, runner=None):
    completed = (runner or RUN)(
        [executable, "plugin", "list"],
        text=True, encoding="utf-8", capture_output=True, check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError("agy plugin list exited %d" % completed.returncode)
    out = (completed.stdout or "").strip()
    if out == "No imported plugins.":
        return {"imports": []}
    return json.loads(out)


def collect(repo_root=None):
    self_version = _manifest_version()
    override_version = marketplace_version(repo_root) if repo_root else None
    if repo_root and not override_version:
        return self_version, [Check(
            "repository.manifest", "ERROR",
            "the requested repository marketplace manifest is unreadable",
        )]
    checks = package_metadata_checks()
    installed_by_harness = {}
    queried = []

    for harness in ("claude", "codex", "agy"):
        executable = _find_executable(harness)
        harness_label = HARNESS_LABELS[harness]
        if not executable:
            checks.append(Check(
                harness + ".cli", "SKIP",
                "%s CLI is unavailable" % harness_label,
            ))
            installed_by_harness[harness] = []
            continue
        try:
            if harness == "agy":
                plugins = normalize_agy_plugins(query_agy(executable))
                local_version = None
            else:
                plugin_payload = _run_json(executable, ["plugin", "list", "--json"])
                market_payload = _run_json(
                    executable, ["plugin", "marketplace", "list", "--json"]
                )
                plugins = (
                    normalize_claude_plugins(plugin_payload)
                    if harness == "claude" else normalize_codex_plugins(plugin_payload)
                )
                local_version = _local_expected_version(harness, market_payload)
        except (OSError, RuntimeError, TypeError, ValueError, subprocess.SubprocessError):
            flag = "" if harness == "agy" else " --json"
            checks.append(Check(
                harness + ".query", "ERROR",
                "%s plugin state could not be queried" % harness_label,
                "Run `%s plugin list%s` directly, repair that error, then rerun p doctor."
                % (harness, flag),
            ))
            installed_by_harness[harness] = []
            continue

        queried.append(harness)
        expected = override_version or local_version or self_version
        checks.extend(evaluate_harness(harness, plugins, expected))
        if harness == "codex":
            checks.extend(codex_config_checks())
        installed = [item for item in plugins if item.get("id") == PLUGIN_ID]
        installed_by_harness[harness] = installed
        if len(installed) == 1 and installed[0].get("enabled"):
            root = installed[0].get("root")
            if root and not Path(root).is_dir():
                checks.append(Check(
                    harness + ".content", "FAIL",
                    "%s installed copy of p %s is missing or unreadable, so its files and hooks were not checked"
                    % (harness_label, installed[0].get("version") or "(unknown)"),
                    _version_fix(harness, installed[0].get("scope", "user")),
                ))
            elif HOOK_CONTRACTS.get(harness) is None:
                checks.extend(probe_plugin_hooks(harness, root or ""))
            elif root:
                checks.extend(probe_plugin_hooks(harness, root))
            else:
                checks.append(Check(
                    harness + ".hooks", "ERROR",
                    "%s did not report the installed plugin root" % harness_label,
                    _version_fix(harness, installed[0].get("scope", "user")),
                ))

    if queried and not any(installed_by_harness[h] for h in queried):
        checks.append(Check(
            "install.any", "FAIL",
            "no available harness has p@polstools installed",
            "Install p with the commands in the README, then start a new session.",
        ))
    elif not queried and not any(c.status == "ERROR" for c in checks):
        checks.append(Check(
            "install.any", "FAIL",
            "no supported harness CLI is available, so no installation was checked",
            "Put claude, codex, or agy on PATH, then rerun p doctor.",
        ))

    versions = {
        items[0].get("version") for items in installed_by_harness.values()
        if len(items) == 1 and items[0].get("version")
    }
    if len(versions) > 1:
        checks.append(Check(
            "cross_harness.version", "FAIL",
            "installed harnesses load different p versions",
            "Run p's `p-update` guard, then start new sessions.",
        ))
    elif versions:
        checks.append(Check(
            "cross_harness.version", "PASS",
            "installed harnesses agree on p version %s" % next(iter(versions)),
        ))
    roots = {
        harness: (items[0].get("version"), items[0].get("root"))
        for harness, items in installed_by_harness.items()
        if len(items) == 1 and items[0].get("root") and Path(items[0]["root"]).is_dir()
    }
    if roots:
        checks.extend(content_checks(roots, repo_root))
        checks.extend(python_checks(roots))
    checks.extend(activation_checks())
    checks.extend(statusline_checks())
    return override_version or self_version, checks


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--repo-root",
        help="compare installations with this local marketplace root",
    )
    parser.add_argument("--json", action="store_true", help="emit path-free JSON")
    args = parser.parse_args(argv)
    try:
        expected, checks = collect(args.repo_root)
    except (OSError, ValueError, json.JSONDecodeError):
        print("p doctor: package manifest cannot be read", file=sys.stderr)
        return 2
    code = exit_code(checks)
    if args.json:
        print(json.dumps({
            "expectedVersion": expected,
            "checks": [check._asdict() for check in checks],
            "exitCode": code,
        }, indent=2, sort_keys=True))
    else:
        sys.stdout.write(render(checks, expected))
    return code


if __name__ == "__main__":
    raise SystemExit(main())
