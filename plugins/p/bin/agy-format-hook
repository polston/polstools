#!/usr/bin/env sh
# Antigravity PreInvocation hook for the p response format.
#
# Antigravity runs this from the plugin's root hooks.json with the plugin root
# as the working directory and camelCase JSON on stdin, before every model
# invocation. The decision is format-gate's, unchanged: this entry passes
# conversationId on as the gate's session id, names the harness, and gates a
# pre-encoded JSON envelope, so the gate's verbatim payload is already valid
# hook output. The first invocation (invocationNum 0, which protojson omits)
# gets the full specification; later invocations get the turn reminder.
#
# The off path starts no interpreter: stdin is read and cut with shell
# builtins, and format-gate decides off in sh. Output: the envelope when the
# gate is on, otherwise {}. Exit: always 0 - a hook must not break the agent
# loop; a gate failure prints {} and one line on stderr, which p-doctor
# reports.
#
# Session probe: only when `p-session-probe --arm` has created the arming
# marker does this entry append one names-only line to the trace file the
# arming step created in the private per-user state directory. It refuses,
# writing nothing, unless that directory is a real directory (not a link)
# owned by this user with mode 0700 and the trace file is a regular file,
# not a link. Without the marker the cost is one file test.

here=${0%/*}
[ "$here" = "$0" ] && here=.

event=''
while IFS= read -r line || [ -n "$line" ]; do
  event=$event$line
done

# Value of a top-level "key": cut to its leading [A-Za-z0-9._-] run.
field() {
  case $event in
    *"\"$1\""*) ;;
    *) value=''; return ;;
  esac
  value=${event#*\"$1\"}
  value=${value#*:}
  while :; do
    case $value in
      [[:space:]]* | \"*) value=${value#?} ;;
      *) break ;;
    esac
  done
  value=${value%%[!A-Za-z0-9._-]*}
}

field conversationId; sid=$value
field invocationNum; invocation=$value
field initialNumSteps; steps=$value
case $invocation in '' | *[!0-9]*) invocation=0 ;; esac
case $steps in '' | *[!0-9]*) steps=0 ;; esac

if [ "$invocation" = 0 ]; then
  payload=$here/../style/antigravity/response-format.json
else
  payload=$here/../style/antigravity/turn-reminder.json
fi

output=$(P_FORMAT_HARNESS=antigravity sh "$here/format-gate" gate "$payload" \
  --hook-id format.pre-invocation --hook-version 1 --trigger-kind PreInvocation \
  <<EOF
{"session_id":"$sid"}
EOF
)
status=$?
if [ "$status" -ne 0 ]; then
  state=error
  output=''
  echo "agy-format-hook: format gate exited $status" >&2
elif [ -n "$output" ]; then
  state=on
else
  state=off
fi

# The arming marker sits beside the format defaults file (format-ctl's
# config_path, as format-gate reproduces it).
if [ -n "${P_FORMAT_CONFIG_FILE:-}" ]; then
  case $P_FORMAT_CONFIG_FILE in
    */*) armed=${P_FORMAT_CONFIG_FILE%/*}/session-probe.armed ;;
    *) armed=./session-probe.armed ;;
  esac
elif [ -n "${LOCALAPPDATA:-}" ]; then
  armed=$LOCALAPPDATA/polstools/session-probe.armed
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
  armed=$XDG_CONFIG_HOME/polstools/session-probe.armed
elif [ -n "${HOME:-}" ]; then
  armed=$HOME/.config/polstools/session-probe.armed
else
  armed=''
fi

refuse() {
  echo "agy-format-hook: session probe refused: $1" >&2
}

trace() {
  dir=$(sh "$here/format-gate" state-dir) || {
    refuse "no per-user state directory"; return; }
  if [ ! -d "$dir" ] || [ -L "$dir" ]; then
    refuse "state directory is not a real directory"; return
  fi
  # ls -ldn: mode, links, numeric owner. '@' (macOS extended attributes) and
  # '.' (SELinux context) are allowed suffixes; '+' (an ACL) is not.
  set -- $(ls -ldn "$dir" 2>/dev/null)
  case ${1:-} in
    drwx------ | drwx------@ | drwx------.) ;;
    *) refuse "state directory is not private (mode 0700)"; return ;;
  esac
  if [ "${3:-}" != "$(id -u 2>/dev/null)" ]; then
    refuse "state directory is not owned by this user"; return
  fi
  log=$dir/probe.log
  if [ ! -f "$log" ] || [ -L "$log" ]; then
    refuse "trace file is missing or a link"; return
  fi
  key=${sid:-no-session}
  if ! grep -q "^N $key	" "$log" 2>/dev/null; then
    keys=$(printf '%s\n' "$event" | grep -o '"[A-Za-z0-9_]*"[[:space:]]*:' \
      | sed 's/[":[:space:]]//g' | sort -u | tr '\n' ' ')
    names=$(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' \
      | grep -E '^(ANTIGRAVITY|AGY|CODEX|CLAUDE)_|PLUGIN_ROOT|PLUGIN_DATA|SESSION_ID|THREAD_ID|CONVERSATION_ID' \
      | sort -u | tr '\n' ' ')
    printf 'N %s\t%s\t%s\n' "$key" "$keys" "$names" >> "$log"
  fi
  printf 'R %s\t%s %s %s\n' "$key" "$invocation" "$steps" "$state" >> "$log"
}

if [ -n "$armed" ] && [ -e "$armed" ]; then
  trace
fi

if [ -n "$output" ]; then
  printf '%s\n' "$output"
else
  printf '{}\n'
fi
exit 0
