#!/usr/bin/env python3
"""Per-session gate, session toggles, and durable defaults for the format
plugin's context injection.

gate <payload>  hook entry: print <payload> when the resolved state is on
                (session id read from the hook JSON on stdin)
off | on        toggle the current session (id from the active harness)
status          print the current session's resolved state and its source
default         show the configured defaults
default on|off [--harness claude|codex|antigravity]
                set the durable default globally or for one harness
                (agy is accepted for antigravity)
default clear [--harness claude|codex|antigravity]
                remove the global or one harness's configured default

Resolution order: session toggle, P_FORMAT_DEFAULT, the harness key, then
the global key in the defaults file, then off. The defaults file is
polstools/format.json under the user configuration directory
(P_FORMAT_CONFIG_FILE overrides the path). Harness identity comes from
P_FORMAT_HARNESS, then the Claude, Codex, or Antigravity session variables.

Exit: 0 ran clean; toggle and default subcommands exit 2 when they cannot
run. gate never exits 2: it exits 1 on bad arguments or a missing payload,
because exit 2 from a UserPromptSubmit hook blocks the user's prompt in both
Claude Code and Codex.
"""
import sys

# The plugin's Python floor. This must stay above every use of newer syntax
# or library calls in this file, and before the ready token below.
if sys.version_info < (3, 9):
    sys.exit(1)

import hashlib  # noqa: E402
import json  # noqa: E402
import os  # noqa: E402
import secrets  # noqa: E402
import stat  # noqa: E402
import tempfile  # noqa: E402
import time  # noqa: E402

# The harness reads hook stdout as UTF-8, but on Windows a piped stdout
# defaults to the ANSI code page, which mangles any non-ASCII payload byte.
for _stream in (sys.stdin, sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8")

# python-launcher's single-start mode (used by bin/format-gate) accepts this
# interpreter only if its output begins with the token it passed in.
_ready_token = os.environ.pop("POLSTOOLS_READY_TOKEN", "")
if _ready_token:
    sys.stdout.write(_ready_token)
    sys.stdout.flush()

def _default_flag_dir():
    # The one definition of the flag directory. bin/format-gate's shell fast
    # path recomputes only the cases it can match exactly and otherwise
    # defers to this gate; test_format_gate proves the two never disagree.
    override = os.environ.get("P_FORMAT_STATE_DIR")
    if override:
        return override
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return os.path.join(runtime, "p-format-toggle")
    suffix = str(os.getuid()) if hasattr(os, "getuid") else (os.environ.get("USERNAME") or "default")
    return os.path.join(tempfile.gettempdir(), "p-format-toggle-" + suffix)


FLAG_DIR = _default_flag_dir()
STALE_SECONDS = 14 * 24 * 3600
REFRESH_SECONDS = 24 * 3600
# retro.py's reporting_session_ids() reads this same tuple of session-id env
# vars to exclude the reporting session from a report; keep both in sync.
HARNESSES = ("claude", "codex", "antigravity")
HARNESS_SESSION_VARS = (
    ("claude", ("CLAUDE_CODE_SESSION_ID",)),
    ("codex", ("CODEX_SESSION_ID", "CODEX_THREAD_ID")),
    ("antigravity", ("ANTIGRAVITY_SESSION_ID", "ANTIGRAVITY_CONVERSATION_ID",
                     "AGY_SESSION_ID", "AGY_CONVERSATION_ID")),
)
SESSION_ENV_VARS = tuple(
    name for _, names in HARNESS_SESSION_VARS for name in names)
STATES = ("on", "off")


def flag_path(session_id, state):
    # Hashing keeps any session id, including one with separators or "..",
    # a single file name inside FLAG_DIR.
    digest = hashlib.sha256(session_id.encode("utf-8")).hexdigest()
    return os.path.join(FLAG_DIR, digest + "." + state)


def private_dir(create):
    """True when FLAG_DIR is a real directory owned by this user. With
    create, make it (mode 0700) or tighten a looser mode first. Flags in an
    untrusted directory are never read or written."""
    if create:
        os.makedirs(FLAG_DIR, mode=0o700, exist_ok=True)
    try:
        info = os.lstat(FLAG_DIR)
    except OSError:
        return False
    if not stat.S_ISDIR(info.st_mode):
        return False
    if hasattr(os, "getuid"):
        if info.st_uid != os.getuid():
            return False
        if create and stat.S_IMODE(info.st_mode) != 0o700:
            os.chmod(FLAG_DIR, 0o700)
    return True


def prune():
    try:
        cutoff = time.time() - STALE_SECONDS
        for entry in os.scandir(FLAG_DIR):
            if (entry.name.endswith(".off") or entry.name.endswith(".on")) \
                    and entry.is_file(follow_symlinks=False) \
                    and entry.stat(follow_symlinks=False).st_mtime < cutoff:
                os.unlink(entry.path)
    except OSError:
        pass


def session_from_env():
    visible = visible_sessions()
    override = os.environ.get("P_FORMAT_HARNESS")
    if override in HARNESSES:
        visible = [entry for entry in visible if entry[0] == override]
    if len(visible) == 1:
        return visible[0][1]
    if visible:
        print("format-ctl: session ids for %s are all set, so this session "
              "started inside another; rerun with P_FORMAT_HARNESS set to "
              "this session's harness"
              % " and ".join(harness for harness, _ in visible), file=sys.stderr)
    else:
        print("no supported harness session id is set", file=sys.stderr)
    sys.exit(2)


def config_path():
    override = os.environ.get("P_FORMAT_CONFIG_FILE")
    if override:
        return override
    if os.environ.get("LOCALAPPDATA"):
        base = os.environ["LOCALAPPDATA"]
    else:
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
            os.path.expanduser("~"), ".config")
    return os.path.join(base, "polstools", "format.json")


class MalformedConfig(Exception):
    pass


def load_config():
    """The configured defaults; MalformedConfig when the file exists but is
    not a JSON object. A missing file is an empty configuration."""
    try:
        with open(config_path(), encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as error:
        raise MalformedConfig(str(error))
    if not isinstance(data, dict):
        raise MalformedConfig("not a JSON object")
    return {key: value for key, value in data.items()
            if key in ("default",) + HARNESSES and value in STATES}


def read_config():
    # The hook path: an unreadable file follows the built-in default rather
    # than failing the prompt; `default` reports it instead.
    try:
        return load_config()
    except MalformedConfig:
        return {}


def editable_config():
    try:
        return load_config()
    except MalformedConfig as error:
        print("format-ctl: the defaults file %s is malformed (%s); fix or "
              "remove it" % (config_path(), error), file=sys.stderr)
        sys.exit(2)


def write_config(config):
    path = config_path()
    directory = os.path.dirname(path) or "."
    data = json.dumps(config, indent=2, sort_keys=True) + "\n"
    try:
        os.makedirs(directory, exist_ok=True)
        descriptor, temporary = tempfile.mkstemp(
            prefix="." + os.path.basename(path) + ".", suffix=".tmp", dir=directory)
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                handle.write(data)
            os.replace(temporary, path)
        except BaseException:
            try:
                os.unlink(temporary)
            except OSError:
                pass
            raise
    except OSError as error:
        print("format-ctl: cannot write defaults: %s" % error, file=sys.stderr)
        sys.exit(2)


def visible_sessions():
    """(harness, session id) for every harness whose session variable is
    set. A harness started inside another inherits the outer one's variable,
    so more than one entry means the environment alone cannot say which
    session is running this command."""
    found = []
    for harness, names in HARNESS_SESSION_VARS:
        for name in names:
            if os.environ.get(name):
                found.append((harness, os.environ[name]))
                break
    return found


def harness_name():
    override = os.environ.get("P_FORMAT_HARNESS")
    if override in HARNESSES:
        return override
    visible = visible_sessions()
    return visible[0][0] if len(visible) == 1 else ""


def default_state():
    env_default = os.environ.get("P_FORMAT_DEFAULT")
    if env_default in STATES:
        return env_default, "P_FORMAT_DEFAULT"
    config = read_config()
    harness = harness_name()
    if harness and config.get(harness):
        return config[harness], harness + " default"
    if config.get("default"):
        return config["default"], "global default"
    return "off", "built-in default"


def session_override(session_id):
    if not session_id or not private_dir(create=False):
        return ""
    for state in ("off", "on"):
        path = flag_path(session_id, state)
        try:
            modified = os.stat(path).st_mtime
        except OSError:
            continue
        # Reading a toggle is use: refresh it (at most daily) so pruning
        # removes only toggles no session has read for STALE_SECONDS.
        now = time.time()
        if now - modified > REFRESH_SECONDS:
            try:
                os.utime(path, (now, now))
            except OSError:
                pass
        return state
    return ""


def resolve(session_id):
    override = session_override(session_id)
    if override:
        return override, "session toggle"
    return default_state()


def _telemetry_path():
    """The owned hook-event log under RETRO_HOME, or "" when telemetry is off
    or RETRO_HOME sits inside a Git checkout (telemetry never enters one).
    gate() resolves it once per process and passes it to each event."""
    root = os.environ.get("RETRO_HOME")
    if not root:
        return ""
    resolved_root = os.path.abspath(root)
    current = resolved_root
    while True:
        if os.path.isdir(os.path.join(current, ".git")):
            return ""
        parent = os.path.dirname(current)
        if parent == current:
            break
        current = parent
    return os.path.join(resolved_root, "telemetry", "owned-hook-events.jsonl")


def _emit_hook_event(path, base, event, **values):
    if not path:
        return
    payload = {**base, "event": event, "observed_at_ns": time.time_ns(), **values}
    data = (json.dumps(payload, sort_keys=True, separators=(",", ":"))
            + "\n").encode("utf-8")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            os.write(descriptor, data)
        finally:
            os.close(descriptor)
    except OSError:
        pass


def hook_session_id():
    """The hook input's session id, or None when the input does not carry a
    usable one. Unusable input follows the configured default."""
    try:
        data = json.load(sys.stdin)
    except (OSError, ValueError):
        return None
    sid = data.get("session_id") if isinstance(data, dict) else None
    return sid if isinstance(sid, str) and sid else None


def gate(payload, *, hook_id="", hook_version="", trigger_kind=""):
    started = time.perf_counter_ns()
    base = {
        "schema_version": 1,
        "source": "polstools.format",
        "hook_id": hook_id,
        "hook_version": hook_version,
        "trigger_kind": trigger_kind,
        "invocation_id": secrets.token_hex(12),
    }
    sink = _telemetry_path()
    _emit_hook_event(sink, base, "opportunity")
    _emit_hook_event(sink, base, "start")
    state, _ = resolve(hook_session_id())
    if state == "off":
        _emit_hook_event(
            sink, base, "end", status="disabled", latency_ms=max(
                0, (time.perf_counter_ns() - started) // 1_000_000),
            injected_bytes=0, content_sha256=hashlib.sha256(b"").hexdigest())
        return 0
    try:
        with open(payload, encoding="utf-8") as f:
            content = f.read()
        sys.stdout.write(content)
    except OSError as e:
        print("format-ctl: cannot read payload: %s" % e, file=sys.stderr)
        _emit_hook_event(
            sink, base, "end", status="missing_payload", latency_ms=max(
                0, (time.perf_counter_ns() - started) // 1_000_000),
            injected_bytes=0, content_sha256=hashlib.sha256(b"").hexdigest())
        return 1
    encoded = content.encode("utf-8")
    _emit_hook_event(
        sink, base, "end", status="ok", latency_ms=max(
            0, (time.perf_counter_ns() - started) // 1_000_000),
        injected_bytes=len(encoded),
        content_sha256=hashlib.sha256(encoded).hexdigest())
    return 0


def set_session(state):
    sid = session_from_env()
    try:
        if not private_dir(create=True):
            print("format-ctl: the toggle directory is not a private directory "
                  "owned by this user; set P_FORMAT_STATE_DIR to one",
                  file=sys.stderr)
            sys.exit(2)
        prune()
        path = flag_path(sid, state)
        os.close(os.open(path, os.O_WRONLY | os.O_CREAT, 0o600))
        os.utime(path, None)
    except OSError as error:
        print("format-ctl: cannot write the session toggle: %s" % error,
              file=sys.stderr)
        sys.exit(2)
    other = "on" if state == "off" else "off"
    try:
        os.unlink(flag_path(sid, other))
    except OSError:
        pass
    print("response format %s for this session" % state.upper())


def show_status():
    state, source = resolve(session_from_env())
    print("response format %s for this session (%s)" % (state.upper(), source))


def default_command(args):
    if not args or args == ["show"]:
        config = editable_config()
        for key, label in [("default", "global")] + [(h, h) for h in HARNESSES]:
            print("%s default: %s" % (label, config.get(key, "(unset)")))
        state, source = default_state()
        print("effective default here: %s (%s)" % (state.upper(), source))
        return
    action, rest = args[0], args[1:]
    harness = ""
    if rest[:1] == ["--harness"] and len(rest) == 2:
        candidate = rest[1]
        if candidate == "agy":
            candidate = "antigravity"
        if candidate in HARNESSES:
            harness = candidate
        else:
            print(__doc__, file=sys.stderr)
            sys.exit(2)
    elif rest:
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    config = editable_config()
    scope = ("for " + harness) if harness else "globally"
    if action in STATES:
        config[harness or "default"] = action
        write_config(config)
        print("response format default %s %s" % (action.upper(), scope))
    elif action == "clear":
        config.pop(harness or "default", None)
        write_config(config)
        print("response format default cleared %s" % scope)
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)


def main():
    args = sys.argv[1:]
    if args and args[0] == "gate":
        options = dict(zip(args[2::2], args[3::2]))
        if len(args) % 2 or set(options) - {
                "--hook-id", "--hook-version", "--trigger-kind"}:
            print(__doc__, file=sys.stderr)
            sys.exit(1)
        sys.exit(gate(
            args[1], hook_id=options.get("--hook-id", ""),
            hook_version=options.get("--hook-version", ""),
            trigger_kind=options.get("--trigger-kind", "")))
    if args and args[0] == "default":
        default_command(args[1:])
        return
    if len(args) != 1 or args[0] not in ("off", "on", "status"):
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    if args[0] == "status":
        show_status()
    else:
        set_session(args[0])


main()
