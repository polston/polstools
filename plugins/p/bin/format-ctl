#!/usr/bin/env python3
"""Per-session gate and toggle for the format plugin's context injection.

gate <payload>  hook entry: print <payload> unless this session is toggled
                off (session id read from the hook JSON on stdin; unreadable
                input fails open to ON)
off | on        toggle the current session (id from the active harness)
status          print the current session's state

Exit: 0 ran clean; toggle subcommands exit 2 when they cannot run. gate exits
1 on a bad payload instead — exit 2 from a UserPromptSubmit hook blocks
processing and erases the user's prompt, which a broken payload must never do.
"""
import hashlib
import json
import os
import secrets
import sys
import tempfile
import time

# The harness reads hook stdout as UTF-8, but on Windows a piped stdout
# defaults to the ANSI code page, which mangles any non-ASCII payload byte.
for _stream in (sys.stdin, sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8")

# The flags are disposable session state. The OS temp directory is writable in
# both harness sandboxes and keeps the files out of repositories and config.
FLAG_DIR = os.environ.get("P_FORMAT_STATE_DIR") or os.path.join(
    tempfile.gettempdir(), "p-format-toggle"
)
STALE_SECONDS = 14 * 24 * 3600
# retro.py's reporting_session_ids() reads this same tuple of session-id env
# vars to exclude the reporting session from a report; keep both in sync.
SESSION_ENV_VARS = (
    "CLAUDE_CODE_SESSION_ID",
    "CODEX_SESSION_ID",
    "CODEX_THREAD_ID",
)


def flag_path(session_id):
    return os.path.join(FLAG_DIR, session_id + ".off")


def prune():
    try:
        cutoff = time.time() - STALE_SECONDS
        for entry in os.scandir(FLAG_DIR):
            if entry.name.endswith(".off") and entry.stat().st_mtime < cutoff:
                os.unlink(entry.path)
    except OSError:
        pass


def session_from_env():
    for name in SESSION_ENV_VARS:
        sid = os.environ.get(name)
        if sid:
            return sid
    print("no supported harness session id is set", file=sys.stderr)
    sys.exit(2)


def _telemetry_path():
    root = os.environ.get("RETRO_HOME")
    if not root:
        return ""
    root = os.path.abspath(root)
    current = root
    while True:
        if os.path.isdir(os.path.join(current, ".git")):
            return ""
        parent = os.path.dirname(current)
        if parent == current:
            break
        current = parent
    return os.path.join(root, "telemetry", "owned-hook-events.jsonl")


def _emit_hook_event(base, event, **values):
    path = _telemetry_path()
    if not path:
        return
    payload = {**base, "event": event, "observed_at_ns": time.time_ns(), **values}
    data = (json.dumps(payload, sort_keys=True, separators=(",", ":"))
            + "\n").encode("utf-8")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            os.write(descriptor, data)
        finally:
            os.close(descriptor)
    except OSError:
        pass


def gate(payload, *, hook_id="", hook_version="", trigger_kind=""):
    started = time.perf_counter_ns()
    base = {
        "schema_version": 1,
        "source": "polstools.format",
        "hook_id": hook_id,
        "hook_version": hook_version,
        "trigger_kind": trigger_kind,
        "invocation_id": secrets.token_hex(12),
    }
    _emit_hook_event(base, "opportunity")
    _emit_hook_event(base, "start")
    sid = None
    try:
        sid = json.load(sys.stdin).get("session_id")
    except (json.JSONDecodeError, OSError, ValueError):
        pass
    if sid and os.path.exists(flag_path(sid)):
        _emit_hook_event(
            base, "end", status="disabled", latency_ms=max(
                0, (time.perf_counter_ns() - started) // 1_000_000),
            injected_bytes=0, content_sha256=hashlib.sha256(b"").hexdigest())
        return 0
    try:
        with open(payload, encoding="utf-8") as f:
            content = f.read()
        sys.stdout.write(content)
    except OSError as e:
        print("format-ctl: cannot read payload: %s" % e, file=sys.stderr)
        _emit_hook_event(
            base, "end", status="missing_payload", latency_ms=max(
                0, (time.perf_counter_ns() - started) // 1_000_000),
            injected_bytes=0, content_sha256=hashlib.sha256(b"").hexdigest())
        return 1
    encoded = content.encode("utf-8")
    _emit_hook_event(
        base, "end", status="ok", latency_ms=max(
            0, (time.perf_counter_ns() - started) // 1_000_000),
        injected_bytes=len(encoded),
        content_sha256=hashlib.sha256(encoded).hexdigest())
    return 0


def main():
    args = sys.argv[1:]
    if args and args[0] == "gate":
        if len(args) not in {2, 8}:
            print(__doc__, file=sys.stderr)
            sys.exit(2)
        options = dict(zip(args[2::2], args[3::2]))
        if set(options) - {"--hook-id", "--hook-version", "--trigger-kind"}:
            print(__doc__, file=sys.stderr)
            sys.exit(2)
        sys.exit(gate(
            args[1], hook_id=options.get("--hook-id", ""),
            hook_version=options.get("--hook-version", ""),
            trigger_kind=options.get("--trigger-kind", "")))
    if len(args) != 1 or args[0] not in ("off", "on", "status"):
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    os.makedirs(FLAG_DIR, exist_ok=True)
    prune()
    path = flag_path(session_from_env())
    if args[0] == "off":
        with open(path, "w", encoding="utf-8"):
            pass
        print("response format OFF for this session")
    elif args[0] == "on":
        if os.path.exists(path):
            os.unlink(path)
        print("response format ON for this session")
    else:
        state = "OFF" if os.path.exists(path) else "ON"
        print("response format %s for this session" % state)


main()
