#!/usr/bin/env sh
# branch-base-check — is the local base branch in sync with its remote?
#
# A pull request diffs against the REMOTE base. If local main is ahead, every
# unpushed commit rides along in the PR and gets swallowed by the squash under
# your one-line title. Run this before cutting a branch, and again before
# opening or merging one.
#
# Read-only: fetches refs, then counts. Nothing is checked out, reset, or pushed.
#
# Usage: branch-base-check [-C <repo>] [-b <base-branch>] [-r <remote>] [-n]
#        -r  remote to compare with (default: origin, else the only remote)
#        -b  base branch (default: the remote's HEAD, else main, else master)
#        -n  skip the fetch and compare with the refs as last fetched
#
# Exit: 0 = in sync, or no remote exists for a PR to target.
#       1 = ahead and/or behind, or the base was never pushed.
#       2 = could not run: usage, setup, or a fetch that failed.

set -eu

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}
die() { echo "$1" >&2; exit 2; }

REPO="."
BASE=""
REMOTE=""
FETCH=1

while [ $# -gt 0 ]; do
  case "$1" in
    -C|-b|-r)
      [ $# -ge 2 ] && [ -n "$2" ] || die "$1 needs an argument"
      case "$1" in
        -C) REPO="$2" ;;
        -b) BASE="$2" ;;
        -r) REMOTE="$2" ;;
      esac
      shift 2 ;;
    -n) FETCH=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

command -v git >/dev/null 2>&1 || die "git not found"
git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $REPO"

# Which remote. An explicit -r must exist. Otherwise origin, or the only remote
# there is; with several and no origin, which one a PR targets is a guess.
if [ -n "$REMOTE" ]; then
  git -C "$REPO" remote get-url "$REMOTE" >/dev/null 2>&1 ||
    die "no remote named '$REMOTE'"
else
  remotes=$(git -C "$REPO" remote)
  if [ -z "$remotes" ]; then
    echo "no remotes — a pull request has nothing to diff against"
    exit 0
  fi
  if printf '%s\n' "$remotes" | grep -qx origin; then
    REMOTE=origin
  elif [ "$(printf '%s\n' "$remotes" | wc -l | tr -d ' ')" -eq 1 ]; then
    REMOTE=$remotes
  else
    die "no remote named 'origin' and several others ($(echo $remotes)); pass -r"
  fi
fi

# Default base = the remote's HEAD as last fetched, else as the remote reports
# it now, else main, else master.
if [ -z "$BASE" ]; then
  BASE=$(git -C "$REPO" symbolic-ref --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null || true)
  BASE=${BASE#"$REMOTE"/}
  if [ -z "$BASE" ] && [ "$FETCH" -eq 1 ]; then
    BASE=$(git -C "$REPO" ls-remote --symref "$REMOTE" HEAD 2>/dev/null \
           | sed -n 's|^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$|\1|p' \
           | head -n 1 || true)
  fi
  [ -n "$BASE" ] || for c in main master; do
    git -C "$REPO" show-ref --verify --quiet "refs/heads/$c" && { BASE="$c"; break; }
  done
fi
[ -n "$BASE" ] || die "could not determine a base branch; pass -b"

git -C "$REPO" show-ref --verify --quiet "refs/heads/$BASE" ||
  die "no local branch '$BASE'"

# A failed fetch leaves the remote-tracking refs as they were, and comparing
# against those can report "in sync" while the remote has moved. Git's own
# error is not echoed: it can carry the remote URL, credentials included.
if [ "$FETCH" -eq 1 ]; then
  git -C "$REPO" fetch --quiet "$REMOTE" >/dev/null 2>&1 ||
    die "fetch from '$REMOTE' failed, so its refs may be stale; run
'git fetch $REMOTE' to see why, or pass -n to compare with the refs as last fetched"
fi

git -C "$REPO" show-ref --verify --quiet "refs/remotes/$REMOTE/$BASE" || {
  echo "no remote branch '$REMOTE/$BASE' — it has never been pushed"; exit 1; }

AHEAD=$(git -C "$REPO" rev-list --count "refs/remotes/$REMOTE/$BASE..refs/heads/$BASE")
BEHIND=$(git -C "$REPO" rev-list --count "refs/heads/$BASE..refs/remotes/$REMOTE/$BASE")

echo "base: $BASE   remote: $REMOTE/$BASE"
[ "$FETCH" -eq 1 ] || echo "(-n: compared with $REMOTE as last fetched, not as it is now)"
echo "ahead:  $AHEAD  (local commits not on the remote)"
echo "behind: $BEHIND  (remote commits not local)"
echo

if [ "$AHEAD" -eq 0 ] && [ "$BEHIND" -eq 0 ]; then
  echo "IN SYNC — safe to branch."
  exit 0
fi

if [ "$AHEAD" -gt 0 ]; then
  echo "STOP: '$BASE' is ahead by $AHEAD. A PR cut from here diffs against"
  echo "$REMOTE/$BASE, so those $AHEAD commits would ride along and be squashed"
  echo "under your change's title. Unpushed commits, most recent first:"
  git -C "$REPO" log --oneline "refs/remotes/$REMOTE/$BASE..refs/heads/$BASE" \
    | head -10 | sed 's/^/    /'
  echo
  echo "  push $BASE first, or:  git rebase --onto $REMOTE/$BASE <your-base>"
fi

if [ "$BEHIND" -gt 0 ]; then
  echo "'$BASE' is behind by $BEHIND — pull or reset before branching, or the"
  echo "branch starts from a stale tree."
fi

exit 1
