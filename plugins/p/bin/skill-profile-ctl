#!/usr/bin/env python3
"""Manage and enforce the p plugin's home/work activation profiles.

Enforcement model: activation is a cooperative gate, not a sandbox. Every
governed SKILL.md and command runs `skill-profile-ctl check <name>` before
acting and stops when it exits 1 or 2; no harness blocks a skill that skips
that step, and no hook enforces it. In Codex, the optional
`sync-native` adapter additionally hides disabled skills from the catalog of
sessions started afterwards. Claude Code has no per-skill catalog control.

Exit: 0 ran clean, 1 a check or validation flagged something, 2 could not run.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys


for _stream in (sys.stdin, sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8")

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_ROOT / "lib"))

import skill_activation as activation  # noqa: E402


MANIFEST_PATH = PLUGIN_ROOT / "profiles" / "skill-activation-v1.json"


def manifest():
    return activation.load_manifest(MANIFEST_PATH)


def _scope(args):
    return "session" if getattr(args, "session", False) else "global"


def _sync_status():
    if os.environ.get("P_SKILL_SKIP_STATUS_SYNC") == "1":
        return
    result = subprocess.run(
        [sys.executable, str(PLUGIN_ROOT / "bin" / "statusline-ctl"), "profile-sync"],
        text=True,
        encoding="utf-8",
        capture_output=True,
    )
    # 1 means there was nothing to update (no supported renderer is active),
    # which is not worth a warning on every toggle.
    if result.returncode not in (0, 1):
        detail = (result.stdout or result.stderr).strip()
        print(
            "profile selected; status indicator not updated"
            + (": " + detail if detail else ""),
            file=sys.stderr,
        )


def command_status(args):
    policy = manifest()
    resolved = activation.resolve(policy)
    buckets = activation.component_buckets(resolved)
    if args.json:
        print(
            json.dumps(
                {
                    "schema_version": 1,
                    "source": resolved["source"],
                    "profile": resolved["profile"],
                    "label": activation.label(resolved),
                    "overrides": resolved["overrides"],
                    "stale_overrides": resolved["stale_overrides"],
                    **buckets,
                },
                sort_keys=True,
            )
        )
    else:
        print(
            "profile %s (%s, %s)"
            % (resolved["profile"], activation.label(resolved), resolved["source"])
        )
        if resolved["overrides"]:
            values = [
                component + "=" + ("on" if enabled else "off")
                for component, enabled in sorted(resolved["overrides"].items())
                if component in policy["components"]
            ]
            if values:
                print("overrides: " + ", ".join(values))
        for bucket in ("enabled", "disabled", "limited"):
            print(bucket + ": " + (", ".join(buckets[bucket]) or "none"))
        if resolved["stale_overrides"]:
            print("warning: stale overrides: " + ", ".join(resolved["stale_overrides"]))
    return 0


def command_profiles(_args):
    policy = manifest()
    for name in sorted(policy["profiles"]):
        print(name)
    return 0


def command_session_profile(args):
    policy = manifest()
    locked = os.environ.get("P_SKILL_PROFILE")
    if locked is not None and locked != args.profile:
        print(
            "cannot select %s: P_SKILL_PROFILE locks this process to %s"
            % (args.profile, locked),
            file=sys.stderr,
        )
        return 2
    if locked == args.profile:
        resolved = activation.resolve(policy)
    else:
        activation.set_profile(policy, args.profile, "session")
        resolved = activation.resolve(policy)
    print(
        "skill profile %s for this session (%s)"
        % (resolved["profile"], activation.label(resolved))
    )
    _sync_status()
    return 0


def _native_notice(policy):
    # sync-native stays explicit (it edits the operator's Codex config), but
    # entries it already wrote must not silently disagree with the profile.
    if activation.native_out_of_date(policy, PLUGIN_ROOT):
        print(
            "Codex catalog entries written by sync-native no longer match; "
            "run `skill-profile-ctl sync-native` to refresh them"
        )


def _lock_notice():
    locked = os.environ.get("P_SKILL_PROFILE")
    if locked is not None:
        print(
            "P_SKILL_PROFILE=%s still governs this process; the change applies "
            "where it is unset" % locked
        )


def command_use(args):
    policy = manifest()
    activation.set_profile(policy, args.profile, "global")
    print("global skill profile set to %s" % args.profile)
    _lock_notice()
    _native_notice(policy)
    return 0


def command_override(args):
    policy = manifest()
    scope = _scope(args)
    locked = os.environ.get("P_SKILL_PROFILE")
    if scope == "session" and locked is not None:
        print(
            "cannot change %s for this session: P_SKILL_PROFILE locks this "
            "process to %s and ignores overrides" % (args.component, locked),
            file=sys.stderr,
        )
        return 2
    activation.set_override(policy, args.component, args.enabled, scope)
    print(
        "%s %s for %s scope"
        % (args.component, "enabled" if args.enabled else "disabled", scope)
    )
    if scope == "global":
        _lock_notice()
        _native_notice(policy)
    return 0


def command_reset(args):
    policy = manifest()
    scope = _scope(args)
    activation.reset_scope(policy, scope)
    print(scope + " skill profile reset")
    return 0


def command_label(args):
    policy = manifest()
    print(activation.label(activation.resolve(policy, session_id=args.session_id)))
    return 0


def _disabled_message(resolved, component):
    print(
        "%s is disabled by the %s profile; run `skill-profile-ctl enable %s --session` to enable it for this session"
        % (component, resolved["profile"], component),
        file=sys.stderr,
    )


def command_check(args):
    policy = manifest()
    if args.component not in policy["components"]:
        raise activation.PolicyError("unknown component")
    try:
        resolved = activation.resolve(policy)
    except activation.PolicyError:
        required = set(policy["components"][args.component]["requires"])
        if required <= {"control-plane", "core"}:
            print(
                "warning: activation policy is invalid; "
                "core/control-plane component allowed",
                file=sys.stderr,
            )
            return 0
        raise
    state = activation.component_state(resolved, args.component)
    if state == "disabled":
        _disabled_message(resolved, args.component)
        return 1
    return 0


def command_check_capability(args):
    policy = manifest()
    if args.capability not in policy["capabilities"]:
        raise activation.PolicyError("unknown capability")
    if args.component is not None and args.component not in policy["components"]:
        raise activation.PolicyError("unknown component")
    try:
        resolved = activation.resolve(policy)
    except activation.PolicyError:
        if args.capability in {"control-plane", "core"}:
            print("warning: activation policy is invalid; core capability allowed", file=sys.stderr)
            return 0
        raise
    if activation.capability_enabled(resolved, args.capability, args.component):
        return 0
    subject = args.component or args.capability
    _disabled_message(resolved, subject)
    return 1


def command_validate(_args):
    policy = manifest()
    try:
        activation.validate_manifest(policy, PLUGIN_ROOT)
    except activation.PolicyError as error:
        print("skill-profile-ctl: " + str(error), file=sys.stderr)
        return 1
    print("skill activation policy valid")
    return 0


def command_sync_native(_args):
    changed = activation.sync_native(manifest(), PLUGIN_ROOT)
    print("Codex skill catalog adapter " + ("updated" if changed else "already current"))
    print("Claude Code and Antigravity: no native per-skill switch exists; a "
          "disabled skill is stopped only by its skill-profile-ctl check guard")
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", required=True)
    status = sub.add_parser("status")
    status.add_argument("--json", action="store_true")
    status.set_defaults(handler=command_status)
    profiles = sub.add_parser("profiles")
    profiles.set_defaults(handler=command_profiles)
    for profile in ("home", "work"):
        toggle = sub.add_parser(profile)
        toggle.set_defaults(handler=command_session_profile, profile=profile)
    use = sub.add_parser("use")
    use.add_argument("profile", choices=("home", "work"))
    use.add_argument(
        "--global", dest="global_scope", action="store_true", required=True
    )
    use.set_defaults(handler=command_use)
    for name, enabled in (("enable", True), ("disable", False)):
        override = sub.add_parser(name)
        override.add_argument("component")
        scopes = override.add_mutually_exclusive_group(required=True)
        scopes.add_argument("--session", action="store_true")
        scopes.add_argument("--global", dest="global_scope", action="store_true")
        override.set_defaults(handler=command_override, enabled=enabled)
    reset = sub.add_parser("reset")
    scopes = reset.add_mutually_exclusive_group(required=True)
    scopes.add_argument("--session", action="store_true")
    scopes.add_argument("--global", dest="global_scope", action="store_true")
    reset.set_defaults(handler=command_reset)
    label = sub.add_parser("label")
    label.add_argument("--session-id")
    label.set_defaults(handler=command_label)
    check = sub.add_parser("check")
    check.add_argument("component")
    check.set_defaults(handler=command_check)
    capability = sub.add_parser("check-capability")
    capability.add_argument("capability")
    capability.add_argument("--component")
    capability.set_defaults(handler=command_check_capability)
    validate = sub.add_parser("validate")
    validate.set_defaults(handler=command_validate)
    native = sub.add_parser("sync-native")
    native.set_defaults(handler=command_sync_native)
    return parser


def main(argv=None):
    try:
        args = build_parser().parse_args(argv)
        return args.handler(args)
    except activation.PolicyError as error:
        print("skill-profile-ctl: " + str(error), file=sys.stderr)
        return 2
    except OSError as error:
        print("skill-profile-ctl: cannot update activation state: " + str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
