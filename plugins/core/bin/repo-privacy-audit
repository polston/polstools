#!/usr/bin/env sh
# repo-privacy-audit — read-only sweep of the six places a git repository can
# hold private data. Reports COUNTS AND LOCATIONS ONLY; it never prints a
# matched value, because its output lands in a transcript.
#
# Read-only by construction: every command below is a query. Nothing is
# rewritten, staged, deleted, or pushed. Removal is deliberately manual.
#
# Usage:
#   repo-privacy-audit [-C <repo>] [-p <extra-pattern>]... [-k] [-v]
#
#   -C  repository to audit (default: current directory)
#   -p  additional POSIX-ERE pattern to sweep for; repeatable. Pass identifiers
#       you care about here rather than editing this file — a pattern committed
#       into a tracked file embeds the thing it hunts.
#   -k  also sweep for secret-ish keywords (password:, api_key=, bearer ...).
#       Off by default: any repo that handles config matches this thousands of
#       times legitimately, and the noise buries the real categories.
#   -v  print matching file paths (paths only, never values)
#
# Results are per category. A lumped total is unusable — "3 emails, 0 private
# IPs" is actionable where "8365 matches" is not.
#
# Exit: 0 = every category read zero. 1 = at least one hit. 2 = usage error.

set -eu

REPO="."
VERBOSE=0
KEYWORDS=0
EXTRA=""

while [ $# -gt 0 ]; do
  case "$1" in
    -C) REPO="${2:?-C needs a path}"; shift 2 ;;
    -p) EXTRA="${EXTRA}${EXTRA:+|}${2:?-p needs a pattern}"; shift 2 ;;
    -k) KEYWORDS=1; shift ;;
    -v) VERBOSE=1; shift ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

command -v git >/dev/null 2>&1 || { echo "git not found" >&2; exit 2; }
git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "not a git repository: $REPO" >&2; exit 2; }

# Categories, not credential prefixes. A prefix sweep (ghp_/sk-/AKIA) reports
# clean while bare hex, chosen passwords, and plain variable values sail past.
# Kept generic: no person, host, or project is named in this file.
CATS="email windows_home_path unix_home_path private_ipv4 mac_address"
[ "$KEYWORDS" -eq 1 ] && CATS="$CATS secretish_assignment"
[ -n "$EXTRA" ] && CATS="$CATS custom"

pattern_for() {
  case "$1" in
    email)                 printf '%s' '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' ;;
    windows_home_path)     printf '%s' '[A-Za-z]:[\\/](Users|home)[\\/][A-Za-z0-9_.-]+' ;;
    unix_home_path)        printf '%s' '/(home|Users)/[A-Za-z0-9_.-]+' ;;
    private_ipv4)          printf '%s' '\b(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}' ;;
    mac_address)           printf '%s' '\b([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b' ;;
    secretish_assignment)  printf '%s' '(password|passwd|secret|api[_-]?key|access[_-]?token|bearer|webhook)[[:space:]]*[:=]' ;;
    custom)                printf '%s' "$EXTRA" ;;
  esac
}

TOP=$(git -C "$REPO" rev-parse --show-toplevel)
NCOMMITS=$(git -C "$REPO" rev-list --all --count)
echo "repo-privacy-audit  —  $TOP"
echo "commits: $NCOMMITS"
echo

# Materialise the expensive inputs once rather than per category.
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM
git -C "$REPO" log --all --format='%B'                       > "$TMP/messages"  2>/dev/null || true
git -C "$REPO" log --all -p                                  > "$TMP/patches"   2>/dev/null || true
git -C "$REPO" tag -l --format='%(contents)'                 > "$TMP/tags"      2>/dev/null || true
git -C "$REPO" log --all --format='%an <%ae> %cn <%ce>' | sort -u > "$TMP/idents" 2>/dev/null || true

total_hits=0
printf '%-22s %9s %9s %9s %9s %9s\n' "category" "msgs" "trees" "patches" "tags" "idents"
printf '%-22s %9s %9s %9s %9s %9s\n' "----------------------" "-----" "-----" "-------" "----" "------"

for cat in $CATS; do
  pat=$(pattern_for "$cat")
  [ -n "$pat" ] || continue
  c1=$(grep -cEI "$pat" "$TMP/messages" 2>/dev/null || true); c1=${c1:-0}
  c2=$(git -C "$REPO" grep -IEl "$pat" $(git -C "$REPO" rev-list --all) 2>/dev/null \
       | sed 's/^[0-9a-f]*://' | sort -u | wc -l | tr -d ' '); c2=${c2:-0}
  c3=$(grep -cEI "$pat" "$TMP/patches"  2>/dev/null || true); c3=${c3:-0}
  c4=$(grep -cEI "$pat" "$TMP/tags"     2>/dev/null || true); c4=${c4:-0}
  c5=$(grep -cEI "$pat" "$TMP/idents"   2>/dev/null || true); c5=${c5:-0}
  sum=$((c1 + c2 + c3 + c4 + c5))
  [ "$sum" -gt 0 ] && total_hits=$((total_hits + 1))
  printf '%-22s %9s %9s %9s %9s %9s\n' "$cat" "$c1" "$c2" "$c3" "$c4" "$c5"

  if [ "$VERBOSE" -eq 1 ] && [ "$c2" -gt 0 ]; then
    git -C "$REPO" grep -IEl "$pat" $(git -C "$REPO" rev-list --all) 2>/dev/null \
      | sed 's/^[0-9a-f]*://' | sort -u | head -15 | sed 's/^/      /'
  fi
done

echo
echo "columns: 1 commit messages · 2 distinct files across all trees ·"
echo "         3 patch lines (added AND removed) · 4 tag messages · 5 identities"

# Place 6: every file ever added. A deleted file is still in history.
echo
echo "--- place 6: sensitive filenames ever added ---"
added=$(git -C "$REPO" log --all --diff-filter=A --name-only --format='' 2>/dev/null \
        | sed '/^$/d' | sort -u \
        | grep -EI '\.(env|pem|key|p12|pfx|jsonl|sqlite|db)$|(^|/)(\.env|credentials|secrets|id_rsa|\.npmrc)' || true)
if [ -n "$added" ]; then
  total_hits=$((total_hits + 1))
  printf '%s\n' "$added" | head -20 | sed 's/^/      /'
else
  echo "      none"
fi

echo
echo "--- largest blobs ever committed (harvested data is usually the biggest thing) ---"
big=$(git -C "$REPO" rev-list --objects --all 2>/dev/null \
      | git -C "$REPO" cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' 2>/dev/null \
      | awk '$1=="blob" && $3>262144 { printf "%12d  %s\n", $3, $4 }' \
      | sort -rn | head -10 \
      | awk '{ printf "      %6.1f MB  %s\n", $1/1048576, $2 }' || true)
[ -n "$big" ] && printf '%s\n' "$big" || echo "      none over 256 KB"

echo
if [ "$total_hits" -eq 0 ]; then
  echo "RESULT: every category read zero across all six places."
  exit 0
fi
echo "RESULT: $total_hits categor(y|ies) with hits."
echo "A match is not a leak. Open the files and read them before concluding"
echo "anything — a filename is not evidence, and a personal address in the"
echo "identity column is often intended."
echo
echo "Reminder: a remote copy is not retracted by rewriting local history."
exit 1
